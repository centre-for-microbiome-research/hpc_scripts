#!/bin/bash
# mqyolo - Run claude, codex, copilot, opencode, or any executable shipped in this
# bin/ directory inside a restricted Apptainer/Singularity container.
#
# Permissions inside the container:
#   - Current directory:        fully read/write
#   - /tmp, /var/tmp:           read/write
#   - Per-user scratch subdirs: read/write (/scratch/microbiome/$USER/non_sensitive/{scratch,tmp})
#   - --rw-paths PATH...:       read/write (extra paths granted at launch)
#   - Everything else:          read-only (Unix permissions still apply)
#   - Non-sensitive /work folders + /scratch/microbiome/$USER/non_sensitive: read-only
#   - --ro-paths PATH...:       read-only (extra paths granted at launch)
#   - sshfs / remote FUSE mounts: NOT visible at all (denied by default; opt a
#                                 path back in with --ro-paths/--rw-paths)
#   - $HOME:                    isolated ephemeral directory, not your real home
#
# mqyolo refuses to launch unless the working directory is within an allowed root
# (/work/microbiome, $HOME, /scratch/microbiome/$USER, or /tmp), since the CWD is
# bound read-write — this limits accidental exposure of unrelated data.
#
# Usage:
#   mqyolo [claude|codex|copilot|opencode|<bin-executable>] [--rw-paths PATH...] [--ro-paths PATH...] [--no-bedrock] [args...]
#   Run `mqyolo --help` for the full FILESYSTEM/option reference.
#
# Environment variables:
#   ANTHROPIC_API_KEY   Required for claude
#   OPENAI_API_KEY      Required for codex, unless it is signed in or set up for
#                       Bedrock (`mqbedrock --setup-codex`)
#   GITHUB_TOKEN        Required for copilot
#   OPENCODE_API_KEY    opencode zen key (opencode also uses ANTHROPIC_API_KEY /
#                       OPENAI_API_KEY, the credentials it stored via
#                       `opencode auth login`, or Bedrock — `mqbedrock --setup-opencode`)
#   AI_TOOL_SIF         Override path to .sif file (default: same dir as this script)
#
# When the host has the PBS batch queue (i.e. `qsub` exists — the aqua login/head
# nodes and compute nodes), each session also starts a host-side mqsub broker (see
# the "mqsub broker" section below) so the in-container AI can drive
# mqsub/mqstat/qstat/qdel even though qsub and python3.9 do not exist in the
# container; jobs it submits are forced into this same sandbox. The
# filesystem-sandbox construction is shared with mqsandbox via _sandbox_common.bash
# so those submitted jobs run under the same constraints, and guidance on what to
# offload is injected into the AI tool.
#
# When mqyolo is run OFF the batch queue (no `qsub` on the host — e.g. a
# workstation that only sshfs-mounts aqua), the broker is not started and the AI
# is instead told there is no queue and to run all work directly on the local
# machine.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=_sandbox_common.bash
source "${SCRIPT_DIR}/_sandbox_common.bash"

SIF="${AI_TOOL_SIF:-${SCRIPT_DIR}/../singularity/ai_tool.sif}"

# JSON config listing /work folders flagged "not sensitive" in the CMR
# work-folders sheet. Found via a path relative to this script so it ships with
# the repo (and the deployed copy). Read fresh on every launch (see below);
# regenerate it from the sheet with `pixi run update-non-sensitive-folders`.
NON_SENSITIVE_FOLDERS_FILE="${SCRIPT_DIR}/../mqyolo-non-sensitive-folders.json"

# Print one non-sensitive folder per line from the JSON config (nothing if the
# file is absent or unparseable, so a missing/broken config is non-fatal). Uses
# python3, falling back to jq, then a minimal grep for quoted absolute paths.
_mqyolo_non_sensitive_folders() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    if command -v python3 &>/dev/null; then
        python3 - "$file" <<'PY' 2>/dev/null
import json, sys
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
    for p in data.get("non_sensitive_folders", []):
        if isinstance(p, str) and p.strip():
            print(p.strip())
except Exception:
    pass
PY
    elif command -v jq &>/dev/null; then
        jq -r '.non_sensitive_folders[]? // empty' "$file" 2>/dev/null
    else
        # Last resort: the only quoted "/..." strings in the file are the folders.
        grep -oE '"/[^"]*"' "$file" 2>/dev/null | tr -d '"'
    fi
}

# Trees mqyolo may be launched from. The working directory is bound read-WRITE
# into the sandbox, so launching from an arbitrary location would expose (and make
# writable) unrelated data to the AI. Restrict CWD to a small set of expected
# areas to limit accidental leakage. Each entry is matched against the resolved
# CWD as both the literal path and its realpath, so the canonical aliases are
# covered too (/work/microbiome -> /mnt/hpccs01/..., /scratch -> /mnt/weka/...).
_mqyolo_allowed_launch_roots() {
    printf '%s\n' \
        /work/microbiome \
        "${HOME:-}" \
        "/scratch/microbiome/${USER:-}" \
        /tmp
}

# True (0) if the resolved working directory CWD_REAL is at or under one of the
# allowed launch roots; false (1) otherwise.
_mqyolo_allowed_cwd() {
    local cwd_real="$1" root root_real
    while IFS= read -r root; do
        [[ -n "$root" && "$root" != "/scratch/microbiome/" ]] || continue
        for root_real in "$root" "$(realpath -m "$root" 2>/dev/null)"; do
            [[ -n "$root_real" ]] || continue
            [[ "$cwd_real" == "$root_real" || "$cwd_real" == "$root_real"/* ]] && return 0
        done
    done < <(_mqyolo_allowed_launch_roots)
    return 1
}

# True (0) if this host has the PBS batch-queue machinery the broker drives: the
# real `qsub` submitter (the broker runs `mqsub`, a python3.9 wrapper around
# qsub). When false — e.g. mqyolo launched on a workstation that only sshfs-mounts
# aqua, or any host without PBS — the broker cannot submit anything, so it is not
# started and the AI is told there is no queue and heavy work must run locally.
# Runs on the host, before the container, where the real PBS binaries live.
_mqyolo_broker_available() {
    command -v qsub &>/dev/null
}

# Print the AWS profile the in-container AI tool will use for Bedrock, or nothing
# if Bedrock is not in play. Used to decide whether to stage a Bedrock-only ~/.aws
# into the sandbox (see sandbox_stage_bedrock_credentials).
#
# The host environment alone is NOT a reliable signal: a plain login shell has
# none of these set, yet Claude Code applies its own `env` block from
# ~/.claude/settings.json to its process — the same file, bound read-write into the
# container — so CLAUDE_CODE_USE_BEDROCK/AWS_PROFILE appear only once Claude is
# running. Read both, environment first.
#
# AWS_BEARER_TOKEN_BEDROCK short-circuits the whole thing: it is already forwarded,
# it is scoped to model invocation, and it needs no profile or credential file.
_mqyolo_bedrock_profile() {
    [[ -n "${AWS_BEARER_TOKEN_BEDROCK:-}" ]] && return 0
    command -v python3 &>/dev/null || return 0
    python3 - "${HOME}/.claude/settings.json" \
             "${CLAUDE_CODE_USE_BEDROCK:-}" "${AWS_PROFILE:-}" <<'PY' 2>/dev/null
import json, sys

settings, use, profile = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(settings) as f:
        env = (json.load(f) or {}).get("env") or {}
except Exception:
    env = {}                      # no/unreadable settings.json is not an error
use = use or str(env.get("CLAUDE_CODE_USE_BEDROCK", ""))
profile = profile or str(env.get("AWS_PROFILE", ""))
if use.lower() not in ("", "0", "false"):
    print(profile or "default")
PY
}

# --- Codex on Bedrock ------------------------------------------------------
# Codex cannot use Claude on Bedrock (it speaks only the OpenAI protocol), but it
# does have a built-in Bedrock provider for the OpenAI models hosted there,
# signing with an AWS profile. `mqbedrock --setup-codex` puts that configuration
# in its own Codex profile file, $CODEX_HOME/<name>.config.toml, which is
# activated by `codex --profile <name>` — so it changes nothing until selected,
# and mqyolo selects it when launching codex.
#
# The name matches mqbedrock's default; MQYOLO_CODEX_PROFILE covers a file
# written with a different --codex-profile.
_mqyolo_codex_bedrock_profile_name() { echo "${MQYOLO_CODEX_PROFILE:-bedrock}"; }

# Print the path of that file if it exists, nothing otherwise. ~/.codex, not
# $CODEX_HOME: that is the directory mqyolo binds into the container, so it is the
# only one Codex can read there.
_mqyolo_codex_bedrock_profile_file() {
    local name="${1:-$(_mqyolo_codex_bedrock_profile_name)}" f
    f="${HOME}/.codex/${name}.config.toml"
    [[ -f "$f" ]] && echo "$f"
    return 0
}

# Print the profile explicitly selected in Codex's passthrough arguments and
# return success when a profile option was present. Supports all forms accepted
# by Codex, including the attached short form `-pNAME`. A missing option value is
# still reported as "present" so mqyolo does not expose default Bedrock
# credentials before Codex diagnoses the malformed command line itself.
_mqyolo_codex_requested_profile() {
    local arg need_value=0
    for arg in "$@"; do
        if [[ "$need_value" -eq 1 ]]; then
            printf '%s\n' "$arg"
            return 0
        fi
        case "$arg" in
            --) return 1 ;;
            --profile=*) printf '%s\n' "${arg#--profile=}"; return 0 ;;
            --profile|-p) need_value=1 ;;
            -p?*) printf '%s\n' "${arg#-p}"; return 0 ;;
        esac
    done
    [[ "$need_value" -eq 1 ]]
}

# Print the provider and AWS profile selected by Codex's effective layered
# configuration, separated by a tab.
# Files are passed in precedence order (base config, then selected profile); root
# model_provider and per-provider aws.profile values in later files override
# earlier ones. This covers a profile layer that changes only reasoning effort
# while inheriting Bedrock from config.toml, without staging Bedrock when the
# layer explicitly switches to another provider. Read with awk because the
# relevant TOML is limited to root scalars and flat provider tables.
_mqyolo_codex_provider_and_aws_profile() {
    local f
    local -a files=()
    for f in "$@"; do
        [[ -s "$f" ]] && files+=("$f")
    done
    [[ ${#files[@]} -gt 0 ]] || return 0
    awk -F= '
        function scalar(line, v) {
            v = line
            sub(/^[^=]*=/, "", v)
            sub(/[ \t]*#.*/, "", v)
            gsub(/^[ \t]+/, "", v)
            gsub(/[ \t]+$/, "", v)
            if (v ~ /^".*"$/ || v ~ /^'\''.*'\''$/)
                v = substr(v, 2, length(v) - 2)
            return v
        }
        FNR == 1 { inroot = 1; inaws = 0; aws_provider = "" }
        /^[ \t]*\[/ {
            header = $0
            sub(/[ \t]*#.*/, "", header)
            gsub(/[ \t]+$/, "", header)
            inroot = 0
            inaws = (header ~ /^[ \t]*\[model_providers\..*\.aws\]$/)
            aws_provider = ""
            if (inaws) {
                aws_provider = header
                sub(/^[ \t]*\[model_providers\./, "", aws_provider)
                sub(/\.aws\]$/, "", aws_provider)
                gsub(/["'\'']/, "", aws_provider)
            }
            next
        }
        inroot && $1 ~ /^[ \t]*model_provider[ \t]*$/ {
            provider = scalar($0)
            next
        }
        inaws && $1 ~ /^[ \t]*profile[ \t]*$/ {
            v = scalar($0)
            if (v != "") profiles[aws_provider] = v
        }
        END { if (provider != "") print provider "\t" profiles[provider] }
    ' "${files[@]}"
}

# --- opencode on Bedrock ---------------------------------------------------
# opencode DOES reach Claude on Bedrock (unlike codex): its built-in
# `amazon-bedrock` provider calls the per-model Converse API, the same one Claude
# Code uses. `mqbedrock --setup-opencode` records that in its own opencode config
# file, ~/.config/opencode/<name>.json, which opencode loads as an additional
# layer over the global config when OPENCODE_CONFIG points at it — so it changes
# nothing until selected, and mqyolo selects it when launching opencode.
#
# The name matches mqbedrock's default; MQYOLO_OPENCODE_CONFIG covers a file
# written with a different --opencode-config.
_mqyolo_opencode_bedrock_config_name() { echo "${MQYOLO_OPENCODE_CONFIG:-bedrock}"; }

# Print the path of that file if it exists, nothing otherwise. ~/.config/opencode,
# not $XDG_CONFIG_HOME/opencode: that is the directory mqyolo binds into the
# container (at /container_home/.config/opencode), so it is the only one opencode
# can read there.
_mqyolo_opencode_bedrock_config_file() {
    local f
    f="${HOME}/.config/opencode/$(_mqyolo_opencode_bedrock_config_name).json"
    [[ -f "$f" ]] && echo "$f"
    return 0
}

# Print the AWS profile an opencode Bedrock config signs with: the `profile` key
# of provider["amazon-bedrock"].options. That profile is what has to be staged
# into the sandbox, exactly as for Claude Code and codex — the difference is only
# where the choice is written down. mqbedrock writes plain JSON (no JSONC
# comments) precisely so this can be a JSON parse; anything unparseable is
# treated as "no profile" rather than an error.
_mqyolo_opencode_aws_profile() {
    [[ -s "$1" ]] || return 0
    command -v python3 &>/dev/null || return 0
    python3 - "$1" <<'PY' 2>/dev/null
import json, sys
try:
    with open(sys.argv[1]) as f:
        cfg = json.load(f) or {}
except Exception:
    sys.exit(0)          # unreadable/hand-edited into JSONC: no profile to stage
opts = (((cfg.get("provider") or {}).get("amazon-bedrock") or {}).get("options") or {})
profile = opts.get("profile")
if isinstance(profile, str) and profile.strip():
    print(profile.strip())
PY
}

# --no-bedrock: write a copy of SRC (the real ~/.claude/settings.json) to DEST with
# env.CLAUDE_CODE_USE_BEDROCK forced to "0", so `claude --settings DEST` disables
# Bedrock for this session without ever touching the real settings.json (which is
# bound read-write and would otherwise carry the change into every future session).
# A missing/unreadable/malformed SRC is treated as {} rather than an error, so the
# override still applies even when there is no settings.json yet. Returns non-zero
# (writing nothing) if python3 is unavailable.
#
# A Bedrock-backed settings.json also routinely carries Bedrock-only model
# identifiers — a region-prefixed inference-profile ID like
# "au.anthropic.claude-sonnet-5" (optionally with a "[1m]" long-context suffix,
# e.g. "au.anthropic.claude-sonnet-5[1m]") in the top-level "model" key and/or the
# ANTHROPIC_MODEL / ANTHROPIC_DEFAULT_OPUS_MODEL / ANTHROPIC_DEFAULT_SONNET_MODEL /
# ANTHROPIC_DEFAULT_HAIKU_MODEL env vars. None of those IDs are valid once the
# session talks to the direct Anthropic API instead of Bedrock, so strip them and
# pin a known-good direct-API model (Opus with the 1M-context beta) instead.
_mqyolo_write_no_bedrock_settings() {
    local src="$1" dest="$2"
    command -v python3 &>/dev/null || return 1
    python3 - "$src" "$dest" <<'PY'
import json, sys

src, dest = sys.argv[1], sys.argv[2]
try:
    with open(src) as f:
        settings = json.load(f) or {}
except Exception:
    settings = {}                 # no/unreadable/malformed settings.json is not an error
env = settings.setdefault("env", {})
env["CLAUDE_CODE_USE_BEDROCK"] = "0"
for _k in ("ANTHROPIC_MODEL", "ANTHROPIC_DEFAULT_OPUS_MODEL",
           "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL"):
    env.pop(_k, None)
settings["model"] = "opus[1m]"
with open(dest, "w") as f:
    json.dump(settings, f, indent=2)
PY
}

# Total physical RAM of this host in whole GB, or "" if it can't be read. Used to
# describe the local budget when mqyolo runs off the batch queue.
_mqyolo_host_mem_gb() {
    local kb
    kb="$(awk '/^MemTotal:/{print $2; exit}' /proc/meminfo 2>/dev/null)"
    [[ -n "$kb" ]] || { echo ""; return; }
    echo $(( kb / 1024 / 1024 ))
}

# Convert a PBS mem string (e.g. 96gb, 98304mb, 2tb) to whole GB, or "" if unknown.
_mqyolo_mem_to_gb() {
    local v="${1,,}" num
    num="${v//[^0-9]/}"
    [[ -n "$num" ]] || { echo ""; return; }
    case "$v" in
        *tb) echo $(( num * 1024 )) ;;
        *gb) echo "$num" ;;
        *mb) echo $(( num / 1024 )) ;;
        *kb) echo $(( num / 1024 / 1024 )) ;;
        *)   echo "" ;;
    esac
}

# Detect where mqyolo is running so the guidance can adapt: a shared login/head
# node (offload heavy work to the queue), inside a PBS job (CPU/RAM already
# allocated, run heavy work directly), or off the batch queue entirely (no mqsub;
# run everything on the local machine). Sets MQYOLO_ENV (login|pbs|local),
# MQYOLO_NCPUS, MQYOLO_MEM_GB. Runs on the host before the container, so it can
# read PBS_* and query qstat for the authoritative allocation.
_mqyolo_detect_resources() {
    MQYOLO_ENV="login"
    MQYOLO_NCPUS=""
    MQYOLO_MEM_GB=""
    if [[ -z "${PBS_JOBID:-}" ]]; then
        # Not inside a PBS job. On aqua this is a login/head node with the batch
        # queue reachable; where the queue is NOT reachable (e.g. a workstation
        # that only sshfs-mounts aqua) there is no mqsub, so heavy work must run
        # locally — report this host's own CPU/RAM as the budget for that case.
        if ! _mqyolo_broker_available; then
            MQYOLO_ENV="local"
            MQYOLO_NCPUS="$(nproc 2>/dev/null || true)"
            MQYOLO_MEM_GB="$(_mqyolo_host_mem_gb)"
        fi
        return 0
    fi
    MQYOLO_ENV="pbs"
    MQYOLO_NCPUS="${NCPUS:-}"
    if command -v qstat &>/dev/null; then
        local line
        while IFS= read -r line; do
            case "$line" in
                *Resource_List.ncpus\ =\ *) [[ -n "$MQYOLO_NCPUS" ]] || MQYOLO_NCPUS="${line##*= }" ;;
                *Resource_List.mem\ =\ *)   MQYOLO_MEM_GB="$(_mqyolo_mem_to_gb "${line##*= }")" ;;
            esac
        done < <(qstat -f "$PBS_JOBID" 2>/dev/null)
    fi
    [[ -n "$MQYOLO_NCPUS" ]] || MQYOLO_NCPUS="$(nproc 2>/dev/null || true)"
}

# If the user's per-user "non_sensitive" scratch tree is mounted, describe it to
# the AI: the tree is readable and its `scratch` subdirectory is writable — a good
# place for large or temporary outputs that belong on scratch rather than the
# working directory. Mirrors sandbox_add_default_scratch_paths; prints nothing when
# the tree is absent so the AI is never told about a mount that does not exist.
_mqyolo_scratch_guidance() {
    local ns="/scratch/microbiome/${USER:-}/non_sensitive" _sub i
    local -a _writable=()
    [[ -n "${USER:-}" ]] || return 0
    if [[ ! -d "$ns" ]]; then
        printf '\n**Scratch space:** there is no `%s`\n' "$ns"
        printf 'directory, so no per-user scratch area is mounted. If the user could use a\n'
        printf 'writable scratch directory for large or temporary outputs, suggest they create\n'
        printf 'one OUTSIDE the sandbox and relaunch mqyolo (the tree is then exposed read-only\n'
        printf 'with its `scratch`/`tmp` subdirectories mounted read-write):\n'
        printf '    mkdir -p %s/scratch\n' "$ns"
        return 0
    fi
    for _sub in "${SANDBOX_SCRATCH_RW_SUBDIRS[@]}"; do
        [[ -d "${ns}/${_sub}" ]] && _writable+=("${ns}/${_sub}")
    done
    printf '\n**Scratch space:** `%s` is mounted read-only' "$ns"
    if (( ${#_writable[@]} )); then
        printf ', and these subdirectories\nare writable: `%s`' "${_writable[0]}"
        for (( i = 1; i < ${#_writable[@]}; i++ )); do
            printf ', `%s`' "${_writable[$i]}"
        done
        printf '. Use a writable scratch directory for\n'
        printf 'large or temporary outputs instead of the working directory when appropriate;\n'
        printf 'submitted jobs see them at the same path.\n'
    else
        printf '. Neither its `scratch` nor `tmp`\n'
        printf 'subdirectory exists yet, so no writable scratch area is mounted. If the user\n'
        printf 'could use a writable scratch directory for large or temporary outputs, suggest\n'
        printf 'they create it OUTSIDE the sandbox and relaunch mqyolo so it gets mounted\n'
        printf 'read-write:\n'
        printf '    mkdir -p %s/scratch\n' "$ns"
    fi
}

# Guidance injected into the AI tool's instructions (claude --append-system-prompt-file
# / codex ~/.codex/AGENTS.md) so it knows where heavy work should run. Single
# source of truth, also dumpable with `mqyolo --print-guidance`. Adapts to the
# detected environment.
_mqyolo_guidance_text() {
    _mqyolo_detect_resources
    if [[ "$MQYOLO_ENV" == "local" ]]; then
        local ncpus="${MQYOLO_NCPUS:-(unknown)}" memphrase="" membudget=""
        if [[ -n "$MQYOLO_MEM_GB" ]]; then
            memphrase=", ${MQYOLO_MEM_GB} GB RAM"
            membudget=" and memory under ${MQYOLO_MEM_GB} GB"
        fi
        printf '# Running commands in this mqyolo sandbox (no batch queue)\n\n'
        printf 'You are in an `mqyolo` sandbox, but NOT on the QUT *aqua* HPC: this host has\n'
        printf 'no PBS batch queue, so `mqsub`/`qsub` are unavailable and work CANNOT be\n'
        printf 'offloaded to a queue. Run everything directly here.\n\n'
        printf -- '- There is no `mqsub` here and no batch queue. Never tell the user to submit\n'
        printf -- '  a job to a queue, and do not reach for `mqsub` — run the command directly.\n'
        printf -- '- This machine has %s CPUs%s. Treat that as a finite budget: size work to it\n' "$ncpus" "$memphrase"
        printf -- '  (e.g. `--threads %s`%s) and avoid oversubscribing the machine.\n' "$ncpus" "$membudget"
        cat <<'GUIDE'
- Only the working directory (plus any paths granted to mqyolo at launch with
  --rw-paths) is writable; everything else is read-only. Write outputs under the
  working directory or /tmp.

**Snakemake:** run `snakemake --cores <N>` directly — there is no cluster to
submit rules to, so do not use a cluster profile.
GUIDE
        return 0
    fi
    if [[ "$MQYOLO_ENV" != "login" ]]; then
        local ncpus="${MQYOLO_NCPUS:-(unknown)}" membudget="" memphrase=""
        if [[ -n "$MQYOLO_MEM_GB" ]]; then
            memphrase=", ${MQYOLO_MEM_GB} GB RAM"
            membudget=" and memory under ${MQYOLO_MEM_GB} GB"
        fi
        printf '# Running commands on this HPC (mqyolo sandbox, inside a PBS job)\n\n'
        printf 'You are in an `mqyolo` sandbox running INSIDE a PBS job with %s CPUs%s\n' "$ncpus" "$memphrase"
        printf 'allocated. This is a finite budget — more than a shared login node, but\n'
        printf 'still limited.\n\n'
        printf -- '- Run work that FITS this allocation directly here, sized to it (e.g.\n'
        printf -- '  `--threads %s`%s).\n' "$ncpus" "$membudget"
        cat <<'GUIDE'
- For anything that needs MORE CPUs/RAM than this job has, or many jobs at once,
  submit it to the batch queue with `mqsub` instead of overloading this job — it
  runs on a separately-sized compute node:
      mqsub -t <cpus> -m <GB_RAM> --hours <H> -- <command>
  Such jobs run inside this same restricted sandbox (only the working directory,
  plus any paths granted to mqyolo at launch, is writable). Companions: `qstat`,
  `qdel`.

**Snakemake:** for a few rules that each fit this allocation, run
`snakemake --cores <N>` locally. For large or highly parallel workflows, prefer
`snakemake --profile aqua`, which submits each rule to the queue via `mqsub`
(separately sized) rather than squeezing everything into this one allocation.
GUIDE
        _mqyolo_scratch_guidance
        return 0
    fi

    cat <<'GUIDE'
# Running commands on this HPC (mqyolo sandbox)

You are in an `mqyolo` sandbox on the QUT *aqua* HPC, on a shared **login node**
inside a restricted container. A batch-queue submitter, `mqsub`, is available.

**Offload heavy work to the batch queue — do NOT run it directly here.**
Anything long-running, CPU-intensive, or memory-hungry (assemblies, alignments,
mapping, large downloads/compression, multi-minute scripts, anything wanting
many cores or more than a few GB of RAM) must be submitted with `mqsub`, not run
on the login node. Quick, cheap work (edits, builds, unit tests, short scripts,
inspecting files) can be run directly. (If instead you want abundant local
resources, start an interactive PBS job and run mqyolo inside it — the guidance
here adapts automatically.)

**Rust builds on the login node: use `--jobs 1`.** When you do run `cargo build`
or `cargo run` directly here, always pass `--jobs 1` (e.g.
`cargo build --release --jobs 1`) so the compile uses a single job and does not
spawn many parallel rustc/codegen processes on the shared head node. For a fuller
parallel build, submit it to the queue instead: `mqsub -t 8 -m 32 -- cargo build --release`.

**Avoid large-scale filesystem traversal on the login node.** Commands that walk
many thousands of files (5000+) — e.g. `find` over a big tree, recursive `ls -R`,
`du -sh` of a large directory, `grep -r`/`rg` across a huge corpus, `tar`/`rsync`
of many files — hammer the shared filesystem and degrade it for everyone. Either
avoid them (narrow the path, cap the depth, or target specific files you already
know) or run them through the queue with `mqsub`, never as a broad scan here.

`mqsub` runs the real submitter on the host and, by default, waits for the job
and returns its output. Usage:

    mqsub --no-email -t <cpus> -m <GB_RAM> --hours <H> -- <command and args>
    mqsub --no-email --bg -t 8 -m 32 --days 2 -- <command>     # submit and return immediately

- `-t` cpus, `-m` GB RAM, `--hours/--days/--weeks` walltime. Size them to the job.
- Jobs run inside this SAME restricted sandbox on the compute node: only the
  working directory (plus any paths granted to mqyolo at launch) is writable;
  everything else is read-only. Write outputs under the current directory.
- Companions: `qstat` (queue status), `qdel` (cancel). Run `mqsub --help` for all options.

**Checking the queue.** `qstat` here lists only YOUR (`$USER`) jobs — other users'
jobs are NOT shown, so a short `qstat` does not mean the cluster is idle. `mqstat`
hints at how busy things are, but for an actual cluster-wide picture use commands
that report aggregate counts (these are not restricted to your jobs):
- `qstat -Q` — per-queue summary: the `Que` (queued/waiting) vs `Run` columns show
  the backlog. A large `Que` relative to `Run` means jobs are waiting and your
  submission may sit in the queue for a while.
- `pbsnodes -aSj` — per-node free/total CPUs and memory (the `f/t` columns). Lots
  of free capacity means jobs should start promptly; near-zero free means the
  cluster is saturated.

**Snakemake:** `snakemake --profile aqua` submits each rule to the batch queue
via `mqsub` under the hood (one queue job per rule), so do not also wrap those
rules in `mqsub` yourself. This suits workflows with a modest number of larger
jobs. When instead there are MANY small/quick rules, one queue job each floods
the scheduler and is dominated by queue latency — in that case run snakemake
itself inside a single allocation and let it run rules locally within it, e.g.
`mqsub -t 24 -m 96 -- snakemake --cores 24` (no aqua profile). Pick per-rule
queue submission vs. one wrapping job based on the number and size of the rules.
GUIDE
    _mqyolo_scratch_guidance
}

# Parse tool name (default: claude), --debug, --rw-paths, --ro-paths, --no-broker
TOOL="claude"
TOOL_SET=0        # 1 once the tool has been chosen (built-in name or repo executable)
REPO_TOOL=0       # 1 if TOOL names an executable shipped alongside this script in bin/
DEBUG=0
NO_BROKER=0
NO_BEDROCK=0
RW_PATHS=()
RO_PATHS=()

# True (0) if ARG names a tool: a bare filename (no path separators) that is an
# executable shipped alongside this script in bin/. Used both to recognise the
# tool positionally and to STOP --rw-paths/--ro-paths path lists before it, so the
# tool name isn't swallowed as a path (mirrors the claude/codex/copilot guards).
_mqyolo_is_repo_tool() {
    [[ "$1" != */* && -f "${SCRIPT_DIR}/$1" && -x "${SCRIPT_DIR}/$1" ]]
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        claude|codex|copilot|opencode) TOOL="$1"; TOOL_SET=1; shift ;;
        --debug)      DEBUG=1;   shift ;;
        --no-broker)  NO_BROKER=1; shift ;;
        --no-bedrock) NO_BEDROCK=1; shift ;;
        --print-guidance) _mqyolo_guidance_text; exit 0 ;;
        --rw-paths)
            shift
            while [[ $# -gt 0 && "$1" != --* && "$1" != claude && "$1" != codex && "$1" != copilot && "$1" != opencode ]]; do
                { [[ "$TOOL_SET" -eq 0 ]] && _mqyolo_is_repo_tool "$1"; } && break
                RW_PATHS+=("$1"); shift
            done
            ;;
        --ro-paths)
            shift
            while [[ $# -gt 0 && "$1" != --* && "$1" != claude && "$1" != codex && "$1" != copilot && "$1" != opencode ]]; do
                { [[ "$TOOL_SET" -eq 0 ]] && _mqyolo_is_repo_tool "$1"; } && break
                RO_PATHS+=("$1"); shift
            done
            ;;
        help|-h|--help)
            cat <<'EOF'
mqyolo - run an AI coding tool inside a sandboxed Apptainer/Singularity container

USAGE
  mqyolo [claude|codex|copilot|opencode|<bin-executable>] [--debug] [--rw-paths PATH...] [--ro-paths PATH...] [--no-broker] [--no-bedrock] [args...]

TOOLS
  claude   (default) Claude Code — passes --dangerously-skip-permissions
  codex              OpenAI Codex — bypasses Codex's own prompts/sandbox, enables search,
                     and disables update checks
  copilot            GitHub Copilot CLI — no auto-mode flag; use Shift+Tab inside session for Autopilot mode
  opencode           opencode — passes --auto to auto-approve permission prompts, and
                     selects the Bedrock config from `mqbedrock --setup-opencode` if present.
                     --auto is only valid on opencode's interactive command and on
                     `opencode run`, so mqyolo places it accordingly and omits it for
                     other subcommands (`mqyolo opencode models`, `... debug paths`, ...).
                     A first argument that is a bare word is taken to be a subcommand;
                     write `./dir` to open the interactive session on a directory.
  <bin-executable>   Any executable file shipped in this script's own bin/ directory
                     (given as a bare name, e.g. `mqyolo claude_science`). It is run
                     by its canonical path inside the container, as-is — no wrapper
                     flags and no injected mqsub guidance. Must be the first argument;
                     remaining args pass through to it. The broker still runs, so it
                     can use mqsub/qstat unless --no-broker is given.

OPTIONS
  --debug              Print the full exec command before running
  --rw-paths PATH...   Bind one or more extra paths into the container as read-write.
                       Jobs submitted via the broker inherit exactly these writable
                       paths; the AI inside the container cannot change them.
  --ro-paths PATH...   Bind one or more extra paths into the container as read-only.
                       Useful to re-expose a specific subdirectory of an otherwise
                       deny-listed tree (see FILESYSTEM below). Like --rw-paths,
                       jobs submitted via the broker inherit exactly these read-only
                       paths; the AI inside the container cannot change them.
  --no-broker          Do not start the mqsub broker (mqsub will be unavailable inside the container)
  --no-bedrock         Force Bedrock off for this session, regardless of
                       ~/.claude/settings.json or the environment. For codex and
                       opencode this just leaves their Bedrock config unselected
                       (see BEDROCK); for claude it goes further. Copies the real
                       settings.json (or {} if absent/unreadable) into the ephemeral
                       container home with env.CLAUDE_CODE_USE_BEDROCK set to "0",
                       strips any Bedrock-only model env vars (ANTHROPIC_MODEL,
                       ANTHROPIC_DEFAULT_OPUS_MODEL/_SONNET_MODEL/_HAIKU_MODEL) and
                       forces "model": "opus[1m]" (Bedrock model IDs like
                       "au.anthropic.claude-sonnet-5" are not valid on the direct
                       API), then passes it to claude via --settings; the real
                       settings.json is never modified. Also skips staging Bedrock
                       AWS credentials.
  --print-guidance     Print the mqsub guidance injected into the AI tool, then exit
  help, -h, --help     Show this help text

  Any remaining arguments are passed through verbatim to the tool.
  For example: mqyolo --resume <session-id>
               mqyolo codex --no-gitignore

LAUNCH DIRECTORY
  The working directory is bound read-write into the container, so mqyolo will
  only start from within one of these trees (to limit accidental data exposure):
    - /work/microbiome (or a subdirectory)
    - $HOME (or a subdirectory)
    - /scratch/microbiome/$USER (or a subdirectory)
    - /tmp (or a subdirectory)

CONTAINER
  Image:  $AI_TOOL_SIF, or <script-dir>/../singularity/ai_tool.sif by default
  Runtime: apptainer (preferred) or singularity

FILESYSTEM INSIDE THE CONTAINER
  Current directory   read-write  (so the AI can edit your code)
  /tmp, /var/tmp      read-write
  --rw-paths          read-write  (extra paths granted at launch)
  /home, /mnt, /pkg,
  /data, and other
  HPC mounts          read-only
  --ro-paths          read-only   (extra paths granted at launch)
  /etc                read-only   (DNS, SSL certs, nsswitch)
  /scratch            NOT visible — never bound, to limit data exfiltration.
                      Use --ro-paths/--rw-paths to opt a specific subdirectory
                      back in; it appears at the same /scratch/... path you gave
                      (even though /scratch is a symlink to /mnt/weka/scratch).
                      EXCEPTION, auto-mounted when present:
                      /scratch/microbiome/$USER/non_sensitive read-only, and its
                      `scratch` subdirectory read-write. Jobs inherit both.
  /work/microbiome    NOT visible, EXCEPT /work/microbiome/sw and
                      /work/microbiome/db which are bound read-only (shared
                      tools and reference databases). Use --ro-paths to opt a
                      specific other subdirectory back in read-only.
  Remote sshfs mounts NOT visible — sshfs (and similar remote FUSE) mounts are
                      denied by default, even read-only, so sensitive data from
                      another host is not exposed just because this workstation
                      mounts it. Use --ro-paths/--rw-paths to opt a specific
                      path back in.
  Everything else     not visible (--contain gives a clean slate)
  ~  (HOME)           isolated ephemeral directory, not your real home;
                      dotfiles are symlinked from your real home so tools
                      like git, ssh etc. pick up your config
  ~/.ssh              NOT visible — shadowed by an empty directory so private
                      keys are never readable. No opt-in.
  ~/.aws              NOT visible — shadowed by an empty directory. It is a
                      credential store: ~/.aws/sso/cache holds an SSO token
                      exchangeable for role credentials across every account
                      you can reach, and ~/.aws/credentials holds long-lived
                      keys, so exposing it even read-only would give the AI
                      your whole AWS identity. For Bedrock-backed models use a
                      credential scoped to model invocation instead (see
                      AWS_BEARER_TOKEN_BEDROCK below). Re-expose deliberately
                      with: --ro-paths ~/.aws
                      EXCEPTION when Bedrock is configured (see BEDROCK below):
                      a generated ~/.aws holding ONLY the static keys of the one
                      profile the AI tool uses, and its region. The SSO token,
                      the AWS CLI role cache and every other profile still stay
                      invisible.

MQSUB FROM INSIDE THE CONTAINER
  Only when the host actually has the PBS batch queue (`qsub` is present, as on
  the aqua login and compute nodes). If mqyolo is run somewhere without a queue
  (no `qsub` — e.g. a workstation that merely sshfs-mounts aqua), the broker is
  NOT started, mqsub is unavailable inside the container, and the AI is told to
  run all work directly on the local machine instead of submitting to a queue.

  qsub and the python3.9 mqsub depends on do not exist inside the container, so
  mqsub cannot run there directly. Instead, mqyolo starts a lightweight broker
  on the host for the duration of the session (one broker per mqyolo session).
  Inside the container, mqsub/qstat/qdel are thin stubs that forward the request to the
  broker, which runs the real command on the host. mqsub jobs are
  automatically submitted with --sandbox, so each job runs on its compute node
  inside the SAME restricted container (only its working directory plus mqyolo's
  --rw-paths writable, and the same deny-list with mqyolo's --ro-paths re-exposed
  read-only) via mqsandbox. Those writable and read-only paths are fixed by mqyolo
  at launch and cannot be changed from inside the container. The broker exits when
  mqyolo exits or is killed; use --no-broker to disable it.

BEDROCK
  A Bedrock-backed Claude Code needs AWS credentials inside the container, but
  ~/.aws is shadowed — which used to leave it with none. Since the network
  blackholes the instance-metadata address, the SDK then hung there rather than
  erroring, and the session simply never answered. So:

  - `mqbedrock --setup-claude` writes the ~/.claude/settings.json (and the
    ~/.claude.json onboarding flag) that turn all of this on, if you have not set
    Claude Code up for Bedrock yet. It refuses to overwrite existing files that
    say something different unless given --force.
  - If AWS_BEARER_TOKEN_BEDROCK is set it is forwarded and nothing else is done.
    This is the preferred credential: it is scoped to model invocation.
  - Otherwise, when Bedrock is configured — CLAUDE_CODE_USE_BEDROCK in the
    environment or in the "env" block of ~/.claude/settings.json (which is where
    it usually lives, since Claude applies that block to its own process) —
    mqyolo copies the static keys of that profile (AWS_PROFILE, else "default")
    out of ~/.aws/credentials into a generated, Bedrock-only ~/.aws in the
    container. The profile must already hold static keys, i.e. the profile
    `mqbedrock` maintains; an SSO-only profile cannot be used here and mqyolo
    warns instead of leaving the tool to hang.
  - Those keys expire (12h for an SSO-issued role). When the broker is running,
    `mqbedrock` is proxied to the host so Claude's awsAuthRefresh hook can mint
    new ones there, and the broker restages them into the live session — no
    relaunch needed. Once the SSO session itself is gone the re-login needs an
    interactive device code, which cannot be approved from inside the container:
    run `mqbedrock` on the host and the session picks the new keys up.
  - Instance-metadata credential lookups are disabled in the container
    (AWS_EC2_METADATA_DISABLED), so a missing credential fails immediately with
    an error instead of hanging on a blackholed address.
  - codex can run on Bedrock too, but NOT on Claude: it speaks only the OpenAI
    protocol, so it uses Bedrock's OpenAI-compatible endpoint and the OpenAI
    models hosted there. `mqbedrock --setup-codex` writes that configuration on
    the host as a Codex profile, ~/.codex/bedrock.config.toml, naming the same
    static AWS profile; mqyolo reads the profile from that file, stages its keys
    as above, and launches codex with `--profile bedrock`. The default model is
    the `global.openai.gpt-5.6-sol` inference profile invoked through the Sydney
    Bedrock Runtime endpoint. If the staged static credentials expire during a
    session, run `mqbedrock` inside the sandbox; the broker refreshes the AWS
    profile selected for that session on the host and restages the live keys.
    The QUT BedrockUserAccess role must separately allow `bedrock:InvokeModel`
    on the global inference profile, its foundation models, and the source
    Region's `project/default`; without that administrator-side grant the signed
    request reaches Bedrock and returns 401 Unauthorized.
  - opencode runs Claude on Bedrock properly: its `amazon-bedrock` provider uses
    the same per-model Converse API Claude Code does. `mqbedrock --setup-opencode`
    writes ~/.config/opencode/bedrock.json — an additional opencode config layer
    naming the same static AWS profile, with au.anthropic.claude-sonnet-5 as the
    default model (Haiku for its cheap side-tasks) — and mqyolo stages that
    profile's keys and points OPENCODE_CONFIG at the file. opencode has no
    auth-refresh hook, so when the keys expire run `mqbedrock` again (from inside
    the sandbox it is forwarded to the host, which restages them live).
  - Pass --no-bedrock to force Bedrock off for one session instead (for codex and
    opencode that is all it does: their config is simply not selected). For claude,
    regardless of ~/.claude/settings.json or the environment: mqyolo copies the
    real settings.json into the ephemeral container home with
    env.CLAUDE_CODE_USE_BEDROCK set to "0", strips any Bedrock-only model env vars,
    and forces "model": "opus[1m]" — a Bedrock settings.json routinely pins a
    region-prefixed inference-profile ID (e.g. "au.anthropic.claude-sonnet-5",
    sometimes with a "[1m]" long-context suffix) that the direct API rejects — then
    passes the copy to claude via --settings, leaving the real settings.json
    untouched. No Bedrock AWS credentials are staged in this case.

CLAUDE SETTINGS
  ~/.cache/           bound read-write so tools can read and write the
                      host cache directory (npm, pip, etc.)
  ~/.claude/          bound read-write so Claude Code can persist config,
                      history and keybindings across sessions
  ~/.claude.json      staged into the container home and written back on
                      exit; if another session modified it while mqyolo was
                      running a timestamped backup is saved to
                      ~/.claude/backups/

CODEX SETTINGS
  ~/.codex/           bound read-write so Codex config, auth and sessions
                      persist across mqyolo runs. When the broker is running,
                      mqyolo's generated guidance is mounted read-only over
                      ~/.codex/AGENTS.md inside the container.
  ~/.codex/bedrock.config.toml
                      written by `mqbedrock --setup-codex` on the host: a Codex
                      profile that runs Codex on Bedrock (see BEDROCK below).
                      When it exists, mqyolo launches codex with
                      `--profile bedrock`, unless you passed --profile/-p
                      yourself or --no-bedrock. MQYOLO_CODEX_PROFILE selects a
                      differently named one.

OPENCODE SETTINGS
  ~/.config/opencode/       bound read-write so opencode config, agents and
                            commands persist across mqyolo runs
  ~/.local/share/opencode/  bound read-write so opencode auth (auth.json) and
                            session storage persist
  ~/.local/state/opencode/  bound read-write for opencode's session/TUI state
  ~/.cache/opencode/        bound read-write so its cache and downloaded helper
                            binaries are not re-fetched every session
                      opencode creates all four at startup, so all four must be
                      writable. Their parent directories (~/.config, ~/.local,
                      ~/.local/share, ~/.local/state) are recreated inside the
                      container as directories of symlinks to your real ones, so
                      other tools still see their config, and XDG_CONFIG_HOME /
                      XDG_DATA_HOME / XDG_STATE_HOME / XDG_CACHE_HOME are pinned
                      at the container home so nothing redirects opencode back
                      onto the read-only real home.
                      mqyolo's generated guidance is mounted read-only over
                      ~/.config/opencode/AGENTS.md (opencode's global rules file)
                      inside the container.
  ~/.config/opencode/bedrock.json
                      written by `mqbedrock --setup-opencode` on the host: an
                      additional opencode config layer that runs opencode on
                      Claude via Bedrock (see BEDROCK below). When it exists,
                      mqyolo launches opencode with OPENCODE_CONFIG pointing at
                      it, unless you set OPENCODE_CONFIG yourself or passed
                      --no-bedrock. MQYOLO_OPENCODE_CONFIG selects a differently
                      named one.

ENVIRONMENT VARIABLES
  ANTHROPIC_API_KEY   Required for claude
  OPENAI_API_KEY      Required for codex, unless it is signed in (~/.codex/auth.json)
                      or set up for Bedrock (see BEDROCK)
  MQYOLO_CODEX_PROFILE  Optional — name of the Codex Bedrock profile file to
                      select for codex (default "bedrock"); needed only if
                      `mqbedrock --setup-codex --codex-profile NAME` used another
  GITHUB_TOKEN        Required for copilot
  OPENCODE_API_KEY    opencode zen key for opencode (it also picks up
                      ANTHROPIC_API_KEY / OPENAI_API_KEY, whatever
                      `opencode auth login` stored in ~/.local/share/opencode, or
                      Bedrock — see BEDROCK)
  OPENCODE_CONFIG     Optional — path to an additional opencode config file. Set
                      it yourself and mqyolo leaves it alone; otherwise mqyolo
                      points it at the Bedrock config written by
                      `mqbedrock --setup-opencode`, when that exists.
  MQYOLO_OPENCODE_CONFIG  Optional — name of the opencode Bedrock config file to
                      select for opencode (default "bedrock", i.e.
                      ~/.config/opencode/bedrock.json); needed only if
                      `mqbedrock --setup-opencode --opencode-config NAME` used another
  OPENAI_BASE_URL     Optional — override OpenAI endpoint
  ANTHROPIC_BASE_URL  Optional — override Anthropic endpoint
  CLAUDE_CODE_USE_BEDROCK  Optional — use AWS Bedrock for Claude
  AWS_BEARER_TOKEN_BEDROCK  Optional — Bedrock API key for Bedrock-backed
                      models (Claude Code via CLAUDE_CODE_USE_BEDROCK, or
                      opencode's amazon-bedrock provider). Preferred over
                      general AWS credentials: it is scoped to Bedrock, so the
                      in-container AI cannot reach the rest of your AWS account.
  AWS_REGION, AWS_DEFAULT_REGION  Optional — Bedrock region (not a credential)

                      General AWS credentials (AWS_PROFILE, AWS_ACCESS_KEY_ID,
                      AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN) are deliberately
                      NOT forwarded: they carry your whole AWS identity, not just
                      model access. To use a role instead of a Bedrock API key,
                      mint a Bedrock-scoped short-lived session on the HOST and
                      pass it in explicitly, e.g.
                        aws sts assume-role --role-arn <role> \
                            --role-session-name mqyolo --duration-seconds 3600 \
                            --policy '{"Version":"2012-10-17","Statement":[{"Effect":"Allow",
                              "Action":["bedrock:InvokeModel","bedrock:InvokeModelWithResponseStream"],
                              "Resource":"*"}]}'
                      then export the returned keys before launching mqyolo (the
                      session policy caps them at model invocation, and they
                      expire).
  AI_TOOL_SIF         Override path to the container image
  TERM, COLORTERM, NO_COLOR  Passed through for correct terminal rendering

PATH INSIDE THE CONTAINER
  Container-installed tools are preferred over same-named user wrappers, including
  Codex installed by the image build. Repo tools shipped with mqyolo are also
  placed on PATH: pixi_cmr_init.py (scaffold a pixi.toml), pixi and mqpixi
  (build/run pixi environments), and the snakemake cluster helpers
  (snakemake_mqsub/snakemake_mqstat).
EOF
            exit 0
            ;;
        *)
            # Allow any executable shipped alongside this script in bin/ to be used
            # as the tool, just like claude/codex/copilot. Only the FIRST positional
            # is treated this way (TOOL_SET guards it), and only a bare filename in
            # this script's own directory (no path separators) — everything else is a
            # passthrough argument to the already-chosen tool.
            if [[ "$TOOL_SET" -eq 0 ]] && _mqyolo_is_repo_tool "$1"; then
                TOOL="$1"; REPO_TOOL=1; TOOL_SET=1; shift
            else
                break
            fi
            ;;
    esac
done

# Auto-mount folders flagged "not sensitive" in the CMR work-folders sheet as
# read-only. They live under the otherwise-denied /work/microbiome tree, so they
# are added to RO_PATHS, which re-exposes them read-only inside the sandbox (and
# jobs submitted via the broker inherit them, just like explicit --ro-paths).
# Non-existent paths are skipped later by sandbox_build_binds, so listing folders
# that aren't present on this host is harmless.
while IFS= read -r _folder; do
    [[ -n "$_folder" ]] && RO_PATHS+=("$_folder")
done < <(_mqyolo_non_sensitive_folders "$NON_SENSITIVE_FOLDERS_FILE")
unset _folder

# Default per-user scratch binds (when present): expose
# /scratch/microbiome/$USER/non_sensitive read-only with its `scratch` subdir
# read-write. Added to RO_PATHS/RW_PATHS so the broker forwards them to jobs too.
sandbox_add_default_scratch_paths

# Restrict where mqyolo may be launched (anti-leakage). The working directory is
# bound read-write into the sandbox; confining launches to these trees limits how
# much unrelated data can accidentally be exposed/made writable. Checked before
# the runtime/image checks so the message is clear regardless of build state.
CWD="$(realpath "$(pwd)")"
if ! _mqyolo_allowed_cwd "$CWD"; then
    {
        echo "Error: mqyolo must be launched from within one of:"
        echo "  - /work/microbiome (or a subdirectory)"
        echo "  - \$HOME (${HOME:-unset}) (or a subdirectory)"
        echo "  - /scratch/microbiome/${USER:-<username>} (or a subdirectory)"
        echo "  - /tmp (or a subdirectory)"
        echo "Current directory is: ${CWD}"
        echo "This restriction limits accidental read-write exposure of unrelated data inside the sandbox."
    } >&2
    exit 1
fi

# Runtime/image checks happen after arg parsing so that informational flags
# (--help, --print-guidance) work even without a built container image.
sandbox_detect_runtime
sandbox_require_sif "$SIF"

# ---------------------------------------------------------------------------
# Build the filesystem sandbox (shared with mqsandbox via _sandbox_common.bash)
# ---------------------------------------------------------------------------
BIND_ARGS=()
ENV_ARGS=()
GPU_ARGS=()

# Ephemeral home directory (cleaned up on exit by the trap below).
sandbox_make_home

# --- Real ~/.claude settings (config, theme, history) — claude-specific ---
# HOME inside the container is /container_home. Bind ~/.claude/ and stage a copy
# of ~/.claude.json there so Claude Code can read/write its auth token and
# settings without touching the read-only home bind.
if [[ -d "${HOME}/.claude" ]]; then
    mkdir -p "${CONTAINER_HOME}/.claude"
    BIND_ARGS+=(--bind "${HOME}/.claude:/container_home/.claude:rw")
fi
if [[ -f "${HOME}/.claude.json" ]]; then
    cp "${HOME}/.claude.json" "${CONTAINER_HOME}/.claude.json"
    _CLAUDE_JSON_CKSUM="$(cksum "${HOME}/.claude.json" 2>/dev/null)"
fi

function _save_claude_json {
    local src="${CONTAINER_HOME}/.claude.json"  # temp staging copy
    local dst="${HOME}/.claude.json"
    if [[ -f "$src" ]]; then
        if [[ -f "$dst" ]] && ! cmp -s "$src" "$dst" && \
           [[ "${_CLAUDE_JSON_CKSUM:-}" != "$(cksum "$dst" 2>/dev/null)" ]]; then
            local backup="${HOME}/.claude/backups/.claude.json.backup.$(date +%s%3N)"
            mkdir -p "${HOME}/.claude/backups"
            cp -f "$dst" "$backup"
            echo "WARNING: ~/.claude.json was modified by another session. Saved backup: $backup" >&2
        fi
        cp -f "$src" "$dst"
    fi
}

# BROKER_PID is set below if the broker starts; the trap cleans up everything.
BROKER_PID=""
_cleaned_up=0
function _cleanup {
    [[ "$_cleaned_up" -eq 1 ]] && return
    _cleaned_up=1
    [[ -n "$BROKER_PID" ]] && kill "$BROKER_PID" 2>/dev/null
    _save_claude_json
    rm -rf "$CONTAINER_HOME"
}
# EXIT covers normal exit; INT/TERM/HUP cover signals. The broker also watches
# this script's PID, so even a kill -9 (which no trap can catch) cannot orphan it.
trap _cleanup EXIT
trap '_cleanup; exit 130' INT
trap '_cleanup; exit 143' TERM HUP

# Read-only/HPC/tmp/rw/CWD binds, then the ephemeral-home dotfiles. Extra
# read-only paths follow a `--` separator (see sandbox_build_binds).
sandbox_build_binds "$CWD" "${RW_PATHS[@]+"${RW_PATHS[@]}"}" -- "${RO_PATHS[@]+"${RO_PATHS[@]}"}"
# The granted paths are passed through so an explicit --ro-paths/--rw-paths on a
# shadowed credential dir (~/.aws) re-exposes it instead of being overridden.
sandbox_home_dotfiles "${RO_PATHS[@]+"${RO_PATHS[@]}"}" "${RW_PATHS[@]+"${RW_PATHS[@]}"}"

# ---------------------------------------------------------------------------
# Bedrock credentials: a Bedrock-only ~/.aws in the ephemeral home
#
# sandbox_home_dotfiles shadows the real ~/.aws, which is what breaks a
# Bedrock-backed Claude Code: settings.json puts CLAUDE_CODE_USE_BEDROCK and
# AWS_PROFILE into Claude's environment, the profile is then unresolvable, and the
# SDK falls through to the blackholed instance-metadata address — so the session
# starts and then silently never answers. Stage just that profile's static keys
# into the ephemeral home (which is already bound rw as /container_home, so no
# extra bind is needed) so model access works while the SSO token, the CLI
# credential cache and every other profile stay invisible.
#
# Skipped when --ro-paths ~/.aws already opted the real directory back in: the
# caller made that choice deliberately, and sandbox_home_dotfiles then leaves
# ~/.aws as a symlink to the real dir rather than shadowing it.
# ---------------------------------------------------------------------------
# `|| true`: a failing probe (unreadable settings.json, python3 blowing up) means
# "no Bedrock", never a dead mqyolo — this runs under `set -e`. --no-bedrock skips
# the probe entirely: there is nothing to stage credentials for once Bedrock is
# forced off.
BEDROCK_PROFILE=""
BEDROCK_AWS_DIR=""
CODEX_BEDROCK_FILE=""     # host path of the Codex Bedrock profile file, when used
OPENCODE_BEDROCK_FILE=""  # host path of the opencode Bedrock config file, when used
CODEX_BASE_CONFIG="${HOME}/.codex/config.toml"
CODEX_HAS_OWN_PROFILE=0
CODEX_CONFIGURES_BEDROCK=0
CODEX_CONFIGURES_OTHER_PROVIDER=0
CODEX_REQUESTED_PROFILE=""
CODEX_EFFECTIVE_SETTINGS=""
if [[ "$NO_BEDROCK" -eq 0 && "$TOOL" == "codex" ]]; then
    # Resolve an explicit profile before staging credentials. Its file, when it
    # configures Bedrock, is authoritative; a non-Bedrock profile must not cause
    # the default Bedrock role to be exposed in the sandbox.
    if CODEX_REQUESTED_PROFILE="$(_mqyolo_codex_requested_profile "$@")"; then
        CODEX_HAS_OWN_PROFILE=1
        [[ -n "$CODEX_REQUESTED_PROFILE" ]] && \
            CODEX_BEDROCK_FILE="$(_mqyolo_codex_bedrock_profile_file "$CODEX_REQUESTED_PROFILE")"
    else
        CODEX_BEDROCK_FILE="$(_mqyolo_codex_bedrock_profile_file)"
    fi
    # With no explicit profile, base config.toml is itself effective even when
    # the mqbedrock-generated default layer does not exist. For an explicit
    # profile, require its layer file to exist before staging inherited settings;
    # Codex will diagnose a missing layer itself.
    if [[ "$CODEX_HAS_OWN_PROFILE" -eq 0 || -n "$CODEX_BEDROCK_FILE" ]]; then
        CODEX_EFFECTIVE_SETTINGS="$(_mqyolo_codex_provider_and_aws_profile \
            "$CODEX_BASE_CONFIG" "$CODEX_BEDROCK_FILE" || true)"
        if [[ -n "$CODEX_EFFECTIVE_SETTINGS" ]]; then
            CODEX_EFFECTIVE_PROVIDER="${CODEX_EFFECTIVE_SETTINGS%%$'\t'*}"
            if [[ "$CODEX_EFFECTIVE_PROVIDER" == *bedrock* ]]; then
                CODEX_CONFIGURES_BEDROCK=1
                BEDROCK_PROFILE="${CODEX_EFFECTIVE_SETTINGS#*$'\t'}"
            else
                CODEX_CONFIGURES_OTHER_PROVIDER=1
            fi
        fi
    fi
fi
if [[ "$NO_BEDROCK" -eq 0 && "$TOOL" == "opencode" && -z "${OPENCODE_CONFIG:-}" ]]; then
    # Same idea for opencode, except its own credential precedence puts
    # AWS_BEARER_TOKEN_BEDROCK FIRST, ahead of a configured profile — so with a
    # bearer token set there is nothing to stage (the fallback below short-circuits
    # on it too). A caller-supplied OPENCODE_CONFIG means they chose their own
    # config, so ours is neither read nor selected.
    OPENCODE_BEDROCK_FILE="$(_mqyolo_opencode_bedrock_config_file)"
    [[ -n "$OPENCODE_BEDROCK_FILE" && -z "${AWS_BEARER_TOKEN_BEDROCK:-}" ]] && \
        BEDROCK_PROFILE="$(_mqyolo_opencode_aws_profile "$OPENCODE_BEDROCK_FILE" || true)"
fi
if [[ "$NO_BEDROCK" -eq 0 && -z "$BEDROCK_PROFILE" ]] \
        && [[ "$TOOL" != "codex" || \
              ( "$CODEX_HAS_OWN_PROFILE" -eq 0 && "$CODEX_CONFIGURES_OTHER_PROVIDER" -eq 0 ) ]]; then
    BEDROCK_PROFILE="$(_mqyolo_bedrock_profile || true)"
fi
if [[ -n "$BEDROCK_PROFILE" && ! -L "${CONTAINER_HOME}/.aws" ]]; then
    if sandbox_stage_bedrock_credentials "$BEDROCK_PROFILE" "${CONTAINER_HOME}/.aws"; then
        BEDROCK_AWS_DIR="${CONTAINER_HOME}/.aws"
        # Safe to forward now, and needed for tools that do not read Claude's
        # settings.json (e.g. opencode's amazon-bedrock provider): the staged
        # directory contains ONLY this profile, so naming it grants nothing beyond
        # the model access the keys already carry.
        ENV_ARGS+=(--env "AWS_PROFILE=${BEDROCK_PROFILE}")
    else
        {
            echo "mqyolo: WARNING: Bedrock is configured (profile '${BEDROCK_PROFILE}') but"
            echo "mqyolo:          ${HOME}/.aws/credentials has no static keys for it, so the"
            echo "mqyolo:          in-container tool will have no model access."
            echo "mqyolo:          Run 'mqbedrock' on the host first, or set AWS_BEARER_TOKEN_BEDROCK."
        } >&2
    fi
fi

# ---------------------------------------------------------------------------
# mqsub broker (one per mqyolo session)
#
# Start a lightweight host-side broker that the container-side mqsub/mqstat/...
# stubs forward to. Its lifetime is tied to this session: the EXIT trap kills it,
# and it also self-terminates by watching this script's PID ($$), so even a
# `kill -9` of mqyolo does not orphan it. The spool and shim dirs live inside
# CONTAINER_HOME, so they are bound into the container for free and removed on
# exit with the rest of the ephemeral home.
# ---------------------------------------------------------------------------
SANDBOX_PATH_PREFIX=""
MQYOLO_GUIDANCE_FILE=""   # in-container path to the mqsub guidance, set when broker is on

# Extra directories to prepend to PATH inside the container, highest priority
# first. Applied via SANDBOX_PATH_PREFIX (sandbox_build_env) AND re-prepended by
# the shim ~/.bashrc below, so they keep winning even after the user's ~/.bashrc is
# (re-)sourced. Paths are the in-container view (CONTAINER_HOME -> /container_home).
_PATH_PREFIX_DIRS=()

# --- Repo tools on PATH inside the container (see sandbox_stage_repo_tools) ---
TOOLS_DIR="${CONTAINER_HOME}/.mqyolo/tools"
sandbox_stage_repo_tools "$TOOLS_DIR" "$SCRIPT_DIR"
_PATH_PREFIX_DIRS+=("/container_home/.mqyolo/tools")
# Re-prepend the image's own tool install locations after the user's bashrc is
# sourced, so a personal ~/bin/codex or ~/.local/bin/codex cannot shadow the
# Codex installed in the container image.
_PATH_PREFIX_DIRS+=("${SANDBOX_CONTAINER_TOOL_DIRS[@]}")

if [[ "$NO_BROKER" -eq 0 && -x "${SCRIPT_DIR}/mqsub-broker" && -x "${SCRIPT_DIR}/mqbroker-stub" ]] \
   && _mqyolo_broker_available; then
    BROKER_SPOOL="${CONTAINER_HOME}/.mqyolo/broker"
    SHIM_DIR="${CONTAINER_HOME}/.mqyolo/shims"
    mkdir -p "$BROKER_SPOOL" "$SHIM_DIR"

    # Symlink the stub as each proxied command. The target must be valid INSIDE
    # the container, so use the canonical path (bound ro under /home|/mnt|/work).
    # qstat/qdel are proxied too so `snakemake --profile aqua` works in the
    # container: its cluster-status helper (snakemake_mqstat) calls `qstat` and its
    # cluster-cancel command is `qdel`, neither of which exists inside the sandbox.
    # pbsnodes is proxied so node-status queries work too (PBS binaries are absent
    # in the container).
    _stub_real="$(readlink -f "${SCRIPT_DIR}/mqbroker-stub")"
    _stub_cmds=(mqsub mqstat mqwait mqdel qstat qdel pbsnodes)
    # mqbedrock is proxied only when a Bedrock credential was actually staged:
    # refreshing it from inside the sandbox is impossible (the SSO token and the
    # writable cache are both on the host), so Claude's awsAuthRefresh hook has to
    # reach the host to mint new keys — and the broker restages them afterwards.
    # Without a staged credential there would be nothing to restage.
    [[ -n "$BEDROCK_AWS_DIR" ]] && _stub_cmds+=(mqbedrock)
    for _c in "${_stub_cmds[@]}"; do
        ln -sf "$_stub_real" "${SHIM_DIR}/${_c}"
    done
    unset _c _stub_real _stub_cmds

    # Pass this session's --rw-paths/--ro-paths to the broker as the FIXED sets of
    # writable and read-only paths for every submitted job. The broker forces these
    # and rejects any attempt to set them from inside the container, so the AI can
    # neither widen what its jobs may write to nor re-expose anything beyond what
    # you granted mqyolo at launch.
    # Pass the literal absolute paths (symlinks preserved, e.g. /scratch/... rather
    # than the resolved /mnt/weka/scratch/...) so a job's sandbox sees them at the
    # same place this session does; sandbox_build_binds resolves the real source and
    # also binds the literal path, so the /scratch symlink (absent in the container)
    # is not required.
    _broker_rw=()
    for _p in "${RW_PATHS[@]+"${RW_PATHS[@]}"}"; do
        _broker_rw+=(--rw-path "$(realpath -s "$_p" 2>/dev/null || echo "$_p")")
    done
    _broker_ro=()
    for _p in "${RO_PATHS[@]+"${RO_PATHS[@]}"}"; do
        _broker_ro+=(--ro-path "$(realpath -s "$_p" 2>/dev/null || echo "$_p")")
    done
    # Where to rewrite the staged Bedrock credentials after a broker-run
    # `mqbedrock` mints new ones, so a live session picks them up without relaunch.
    _broker_bedrock=()
    [[ -n "$BEDROCK_AWS_DIR" ]] && \
        _broker_bedrock=(--bedrock-profile "$BEDROCK_PROFILE" --bedrock-aws-dir "$BEDROCK_AWS_DIR")
    _broker_dbg=()
    [[ "$DEBUG" -eq 1 ]] && _broker_dbg=(--debug)
    "${SCRIPT_DIR}/mqsub-broker" --spool "$BROKER_SPOOL" --watch-pid "$$" \
        "${_broker_rw[@]}" "${_broker_ro[@]}" \
        "${_broker_bedrock[@]+"${_broker_bedrock[@]}"}" "${_broker_dbg[@]}" &
    BROKER_PID=$!
    unset _broker_dbg _broker_rw _broker_ro _broker_bedrock _p

    # The shim dir lives at this path inside the container too (CONTAINER_HOME ->
    # /container_home). It must beat everything (including the repo tools dir) so the
    # container-side mqsub stub shadows the real mqsub; prepend it ahead of the rest.
    _PATH_PREFIX_DIRS=("/container_home/.mqyolo/shims" "${_PATH_PREFIX_DIRS[@]}")
    # Tell the stubs where to drop requests (in-container path).
    ENV_ARGS+=(--env "MQBROKER_SPOOL=/container_home/.mqyolo/broker")

    # Guidance injected into the AI tool's instructions so it knows to offload
    # heavy work to the batch queue via mqsub instead of running it on the login
    # node. Delivered to claude via --append-system-prompt-file and to codex via
    # its global ~/.codex/AGENTS.md (see the tool case below). Same text as
    # `mqyolo --print-guidance`.
    _mqyolo_guidance_text > "${CONTAINER_HOME}/.mqyolo/guidance.md"
    MQYOLO_GUIDANCE_FILE="/container_home/.mqyolo/guidance.md"
fi

# If no broker started because the batch queue is not reachable (mqyolo running
# off aqua, e.g. on a workstation), still inject guidance — the "no queue, run
# locally" variant — so the in-container AI is not left telling the user to submit
# work to an mqsub queue that does not exist here. (.mqyolo already exists from
# sandbox_stage_repo_tools above.)
if [[ -z "$MQYOLO_GUIDANCE_FILE" ]] && ! _mqyolo_broker_available; then
    _mqyolo_guidance_text > "${CONTAINER_HOME}/.mqyolo/guidance.md"
    MQYOLO_GUIDANCE_FILE="/container_home/.mqyolo/guidance.md"
fi

# Join the prefix dirs and expose them on PATH (sandbox_build_env prepends
# SANDBOX_PATH_PREFIX to CONTAINER_PATH). Setting PATH up front is not enough: the
# user's ~/.bashrc (sourced at shell startup, and re-sourced by Claude Code's shell
# snapshot) prepends the real hpc_scripts bin dir, shadowing these. Give the
# container its OWN ~/.bashrc that sources the real one and THEN re-prepends our
# dirs, so they keep winning no matter how often .bashrc is sourced.
# (.bash_profile/.profile both end by sourcing ~/.bashrc, covering login shells.)
SANDBOX_PATH_PREFIX="$(IFS=:; printf '%s' "${_PATH_PREFIX_DIRS[*]}")"

# Anything else that must survive the user's ~/.bashrc gets re-exported by the
# shim too — same reason as PATH: an `--env` value is applied by apptainer BEFORE
# the shim sources the real bashrc, so a bashrc that exports the same variable
# wins. Tool cases append "VAR=value" entries here (see opencode's XDG pinning);
# the shim itself is written after the tool case below, once this is populated.
SANDBOX_SHIM_EXPORTS=()

# ---------------------------------------------------------------------------
# Environment variables (PATH honours SANDBOX_PATH_PREFIX set above)
# ---------------------------------------------------------------------------
# CLAUDE_CODE_USE_BEDROCK is forwarded from the host env normally, but under
# --no-bedrock that would let an already-exported "1" win over the "0" baked into
# the --settings copy below (apptainer forwards the environment regardless of the
# --settings file, and an explicit env var can outrank settings.json). So exclude
# it from the host forward and force it off directly instead.
_MQYOLO_ENV_VARS=(ANTHROPIC_API_KEY OPENAI_API_KEY GITHUB_TOKEN OPENCODE_API_KEY \
                  OPENAI_BASE_URL ANTHROPIC_BASE_URL \
                  AWS_REGION AWS_DEFAULT_REGION AWS_BEARER_TOKEN_BEDROCK \
                  PIXI_CACHE_DIR RATTLER_CACHE_DIR \
                  TERM COLORTERM NO_COLOR \
                  CUDA_VISIBLE_DEVICES NVIDIA_VISIBLE_DEVICES CUDA_DEVICE_ORDER \
                  GPU_DEVICE_ORDINAL)
if [[ "$NO_BEDROCK" -eq 1 ]]; then
    ENV_ARGS+=(--env "CLAUDE_CODE_USE_BEDROCK=0")
else
    _MQYOLO_ENV_VARS+=(CLAUDE_CODE_USE_BEDROCK)
fi
sandbox_build_env "${_MQYOLO_ENV_VARS[@]}"
unset _MQYOLO_ENV_VARS

# ---------------------------------------------------------------------------
# Tool-specific flags
# ---------------------------------------------------------------------------
case "$TOOL" in
    claude)
        # Skip all permission prompts — the container is the sandbox
        YOLO_ARGS=("--dangerously-skip-permissions")
        # Tell Claude to offload heavy commands to mqsub.
        [[ -n "$MQYOLO_GUIDANCE_FILE" ]] && \
            YOLO_ARGS+=("--append-system-prompt-file" "$MQYOLO_GUIDANCE_FILE")
        # --no-bedrock: hand claude a settings copy with Bedrock forced off instead
        # of touching the real ~/.claude/settings.json (which is bound read-write
        # and would otherwise carry the change into every future session).
        if [[ "$NO_BEDROCK" -eq 1 ]]; then
            mkdir -p "${CONTAINER_HOME}/.mqyolo"
            if _mqyolo_write_no_bedrock_settings "${HOME}/.claude/settings.json" \
                    "${CONTAINER_HOME}/.mqyolo/settings-no-bedrock.json"; then
                YOLO_ARGS+=("--settings" "/container_home/.mqyolo/settings-no-bedrock.json")
            else
                echo "mqyolo: WARNING: --no-bedrock needs python3, which is unavailable in this" >&2
                echo "mqyolo:          environment; Bedrock is not being overridden." >&2
            fi
        fi
        ;;
    codex)
        # Run without Codex's own prompts/sandbox inside the mqyolo container,
        # enable Codex web search, and suppress self-update prompts because the
        # SIF rebuild handles updates.
        YOLO_ARGS=(
            "--dangerously-bypass-approvals-and-sandbox"
            "--search"
            "-c" "check_for_update_on_startup=false"
        )
        # Codex reads global instructions from $CODEX_HOME/AGENTS.md (~/.codex).
        # Bind the real ~/.codex read-write so config, auth and sessions persist.
        # The mqyolo guidance is exposed as AGENTS.md via a file bind, so we do
        # not overwrite the user's real ~/.codex/AGENTS.md.
        mkdir -p "${HOME}/.codex"
        _codex_real="$(readlink -f "${HOME}/.codex" 2>/dev/null || echo "${HOME}/.codex")"
        rm -rf "${CONTAINER_HOME}/.codex"
        sandbox_bind_codex_home "$_codex_real" "/container_home/.codex" \
            "${CONTAINER_HOME}/.mqyolo/guidance.md"
        unset _codex_real
        # Select the Bedrock profile file `mqbedrock --setup-codex` wrote, so
        # Codex signs with the staged AWS credentials instead of needing an
        # OPENAI_API_KEY or a ChatGPT login inside the sandbox. Skipped when the
        # caller chose a profile themselves (two --profile flags is an error) and
        # under --no-bedrock, which is what makes that flag work for codex: the
        # file stays on disk but is never activated.
        if [[ -n "$CODEX_BEDROCK_FILE" && "$CODEX_HAS_OWN_PROFILE" -eq 0 ]]; then
            YOLO_ARGS+=("--profile" "$(_mqyolo_codex_bedrock_profile_name)")
        elif [[ -n "$BEDROCK_AWS_DIR" && "$CODEX_HAS_OWN_PROFILE" -eq 0 ]] \
             && [[ "$CODEX_CONFIGURES_BEDROCK" -eq 0 ]] \
             && [[ -z "${OPENAI_API_KEY:-}" && ! -s "${HOME}/.codex/auth.json" ]]; then
            # Bedrock credentials are staged (Claude is set up for it) and codex
            # has no other way to authenticate, so point at the one-off setup
            # rather than letting it open on a login prompt it cannot complete.
            echo "mqyolo: NOTE: codex has no credentials here (no OPENAI_API_KEY, no ~/.codex/auth.json)." >&2
            echo "mqyolo:       To run it on Bedrock like Claude: mqbedrock --setup-codex" >&2
        fi
        ;;
    copilot)
        # No CLI flag for auto mode; use Shift+Tab inside the session for Autopilot mode
        # (Copilot CLI has no global-instructions hook we can inject mqsub guidance into.)
        YOLO_ARGS=()
        ;;
    opencode)
        # Auto-approve permissions that are not explicitly denied — the container
        # is the sandbox, so opencode's own prompts add nothing here.
        #
        # --auto is declared per COMMAND (by the default interactive command and by
        # `run`), and opencode's parser is strict about unknown options, so the flag
        # cannot simply be prefixed: `opencode --auto run ...` is an unknown
        # top-level option and opencode prints its help text instead of running
        # anything. Put the flag where the chosen command accepts it, and leave it
        # off the subcommands that do not declare it (`models`, `debug`, `stats`,
        # ... — which run no tools, so there is nothing to auto-approve; passing it
        # there prints that subcommand's help instead of doing the work).
        #
        # A leading option, or a path-ish first argument (the default command's
        # optional `project` positional), still means the interactive command. A
        # bare word is assumed to be a subcommand, exactly as opencode's own parser
        # resolves it — write `./dir` to open a project directory of that name.
        if [[ $# -eq 0 || "$1" == -* || "$1" == /* || "$1" == .* ]]; then
            YOLO_ARGS=("--auto")
        elif [[ "$1" == run ]]; then
            YOLO_ARGS=("run" "--auto")   # -> opencode run --auto <message...>
            shift
        else
            YOLO_ARGS=()
        fi
        # opencode spreads itself over four XDG dirs and mkdirs ALL of them at
        # startup, so every one must be writable or it dies before the TUI opens:
        # config + its global rules file (AGENTS.md) in ~/.config/opencode,
        # auth.json + session storage in ~/.local/share/opencode, session/TUI
        # state in ~/.local/state/opencode, and cache + downloaded helper binaries
        # in ~/.cache/opencode. Bind all four real dirs read-write so logins,
        # sessions and state persist across runs, and expose the mqyolo guidance as
        # the global AGENTS.md without touching the user's real one.
        mkdir -p "${HOME}/.config/opencode" "${HOME}/.local/share/opencode" \
                 "${HOME}/.local/state/opencode" "${HOME}/.cache/opencode"
        _oc_config="$(readlink -f "${HOME}/.config/opencode" 2>/dev/null || echo "${HOME}/.config/opencode")"
        _oc_data="$(readlink -f "${HOME}/.local/share/opencode" 2>/dev/null || echo "${HOME}/.local/share/opencode")"
        _oc_state="$(readlink -f "${HOME}/.local/state/opencode" 2>/dev/null || echo "${HOME}/.local/state/opencode")"
        _oc_cache="$(readlink -f "${HOME}/.cache/opencode" 2>/dev/null || echo "${HOME}/.cache/opencode")"
        sandbox_bind_opencode_home "$_oc_config" "$_oc_data" "$_oc_state" "$_oc_cache" \
            "${CONTAINER_HOME}/.mqyolo/guidance.md"
        unset _oc_config _oc_data _oc_state _oc_cache
        # Apptainer forwards the host environment, so a host XDG_CONFIG_HOME /
        # XDG_DATA_HOME / XDG_STATE_HOME / XDG_CACHE_HOME would send opencode
        # outside the binds above (onto the read-only real home). Pin all four to
        # the container home — via --env AND via the shim ~/.bashrc, because the
        # container sources the user's real bashrc after apptainer applies --env: a
        # bashrc that exports XDG_* (common with XDG-aware dotfile setups) would
        # otherwise win and send opencode's auth/sessions/state back to the
        # read-only home, silently losing persistence and the AGENTS.md guidance
        # bind — or crashing it outright on the startup mkdir. Same fix as PATH.
        ENV_ARGS+=(--env "XDG_CONFIG_HOME=/container_home/.config" \
                   --env "XDG_DATA_HOME=/container_home/.local/share" \
                   --env "XDG_STATE_HOME=/container_home/.local/state" \
                   --env "XDG_CACHE_HOME=/container_home/.cache")
        SANDBOX_SHIM_EXPORTS+=("XDG_CONFIG_HOME=/container_home/.config" \
                               "XDG_DATA_HOME=/container_home/.local/share" \
                               "XDG_STATE_HOME=/container_home/.local/state" \
                               "XDG_CACHE_HOME=/container_home/.cache")
        # Select the Bedrock config `mqbedrock --setup-opencode` wrote, so opencode
        # runs Claude on Bedrock with the staged AWS credentials instead of needing
        # an API key or an `opencode auth login` inside the sandbox. OPENCODE_CONFIG
        # names an ADDITIONAL config layer, so the user's own opencode.json still
        # applies — this only wins on the keys it sets (provider/model). Pinned via
        # the shim bashrc as well as --env, same reason as the XDG_* vars above.
        # Skipped when the caller set OPENCODE_CONFIG themselves, and under
        # --no-bedrock, which is what makes that flag work for opencode: the file
        # stays on disk but is never selected.
        if [[ -n "$OPENCODE_BEDROCK_FILE" ]]; then
            _oc_bedrock_cfg="/container_home/.config/opencode/$(_mqyolo_opencode_bedrock_config_name).json"
            ENV_ARGS+=(--env "OPENCODE_CONFIG=${_oc_bedrock_cfg}")
            SANDBOX_SHIM_EXPORTS+=("OPENCODE_CONFIG=${_oc_bedrock_cfg}")
            unset _oc_bedrock_cfg
        elif [[ -n "$BEDROCK_AWS_DIR" && -z "${OPENCODE_CONFIG:-}" ]] \
             && [[ -z "${OPENCODE_API_KEY:-}" && -z "${ANTHROPIC_API_KEY:-}" \
                   && -z "${OPENAI_API_KEY:-}" \
                   && ! -s "${HOME}/.local/share/opencode/auth.json" ]]; then
            # Bedrock credentials are staged (Claude is set up for it) but opencode
            # has no config naming them and no other credential, so it would open on
            # a login prompt that cannot be completed in the sandbox — or guess a
            # region. Point at the one-off setup instead.
            echo "mqyolo: NOTE: opencode has no credentials here (no OPENCODE_API_KEY/ANTHROPIC_API_KEY," >&2
            echo "mqyolo:       no ~/.local/share/opencode/auth.json)." >&2
            echo "mqyolo:       To run it on Bedrock like Claude: mqbedrock --setup-opencode" >&2
        fi
        ;;
    *)
        # A repo executable (see arg parsing): run it as-is with no wrapper flags and
        # no injected guidance — it is not one of the AI tools we know how to drive.
        YOLO_ARGS=()
        ;;
esac

# Give the container its OWN ~/.bashrc: it sources the user's real one and THEN
# re-asserts our PATH prefix and any SANDBOX_SHIM_EXPORTS the tool case added, so
# they keep winning no matter how often .bashrc is re-sourced (Claude Code's shell
# snapshot re-sources it too). Written here, after the tool case, so tool-specific
# pins are included. (.bash_profile/.profile both end by sourcing ~/.bashrc,
# covering login shells.)
_real_bashrc="$(readlink -f "${HOME}/.bashrc" 2>/dev/null || true)"
sandbox_write_shim_bashrc "${CONTAINER_HOME}/.bashrc" "$_real_bashrc" \
    "$SANDBOX_PATH_PREFIX" "${SANDBOX_SHIM_EXPORTS[@]+"${SANDBOX_SHIM_EXPORTS[@]}"}"
unset _real_bashrc

# Expose the host NVIDIA driver + device nodes when this machine has a GPU (an
# interactive PBS GPU job, or a GPU workstation) — without them CUDA sees no
# driver at all inside --contain. No-op on a CPU-only login node.
sandbox_add_gpu_args

# Drop duplicate-destination binds (e.g. non-sensitive /work folders re-exposed
# via --ro-paths over the ro-allow and /proc/mounts binds) so apptainer doesn't
# warn "destination is already in the mount point list". Last bind per dest wins.
sandbox_dedupe_binds

# The command to exec inside the container. Built-in tools (claude/codex/copilot)
# are resolved by name on the container PATH; a repo executable is run by its
# canonical path, which is bound read-only into the container along with the rest
# of bin/ (under /home|/mnt|/work), so it resolves regardless of PATH.
TOOL_CMD="$TOOL"
if [[ "$REPO_TOOL" -eq 1 ]]; then
    TOOL_CMD="$(readlink -f "${SCRIPT_DIR}/${TOOL}")"
fi

# ---------------------------------------------------------------------------
# Run (as a child, not exec, so the EXIT trap fires: broker teardown,
# .claude.json save-back, and ephemeral-home cleanup all depend on it)
# ---------------------------------------------------------------------------
if [[ "$DEBUG" -eq 1 ]]; then
    echo "mqyolo: exec command:" >&2
    printf '  %q' "$RUNTIME" exec --contain \
        "${GPU_ARGS[@]+"${GPU_ARGS[@]}"}" \
        "${BIND_ARGS[@]}" "${ENV_ARGS[@]}" \
        --pwd "${CWD}" "${SIF}" \
        bash -c '[[ -f ~/.bashrc ]] && source ~/.bashrc 2>/dev/null; exec "$@"' _ \
        "${TOOL_CMD}" "${YOLO_ARGS[@]}" "$@" >&2
    echo >&2
fi

"$RUNTIME" exec \
    --contain \
    "${GPU_ARGS[@]+"${GPU_ARGS[@]}"}" \
    "${BIND_ARGS[@]}" \
    "${ENV_ARGS[@]}" \
    --pwd "${CWD}" \
    "${SIF}" \
    bash -c '[[ -f ~/.bashrc ]] && source ~/.bashrc 2>/dev/null; exec "$@"' _ \
    "${TOOL_CMD}" "${YOLO_ARGS[@]}" "$@"
exit $?
