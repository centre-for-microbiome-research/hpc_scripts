#!/usr/bin/env bash
#
# bedrock-refresh.sh — keep a static AWS profile topped up for Claude Code.
#
# Why this exists: QUT's SSO access token dies after ~1h and cannot be
# refreshed silently, but the role credentials it issued are valid for 12h and
# sit in ~/.aws/cli/cache. Claude Code doesn't read that cache — it re-requests
# credentials from Identity Center and hits the dead token. So this script pulls
# the cached credentials out via the AWS CLI and writes them into a plain
# [bedrock] profile with static keys, which Claude Code can read all day.
#
# Wire it up in ~/.claude/settings.json:
#   "awsAuthRefresh": "mqbedrock",
#   "env": { "CLAUDE_CODE_USE_BEDROCK": "1", "AWS_PROFILE": "bedrock", ... }
# `mqbedrock --setup-claude` writes exactly that (plus the au.* model IDs and the
# onboarding flag in ~/.claude.json) — see setup_claude() below.
#
# Claude Code runs it only after an STS GetCallerIdentity shows the current
# credentials are dead, so within the 12h window this costs one cheap STS call.
#
# Every session's credential dies at the same instant, so several copies of this
# script routinely run at once — and `aws configure set` is an unlocked
# read-modify-write that turns a collision into two `[bedrock]` sections and an
# unparseable credentials file. The write is therefore serialised under a lock,
# and a file already corrupted that way is repaired on the next run: see "the
# static credential file" below.
#
# The same static profile also lets OpenAI Codex run on Bedrock (Codex speaks
# only the OpenAI protocol, so it uses Bedrock's OpenAI-compatible endpoint and
# the OpenAI models hosted there, not Claude): `mqbedrock --setup-codex` writes
# the Codex profile that points at it — see setup_codex() below.
#
# ...and opencode, which does reach Claude on Bedrock (its `amazon-bedrock`
# provider calls the same per-model Converse API Claude Code uses):
# `mqbedrock --setup-opencode` writes the opencode config that points at it —
# see setup_opencode() below.
#
# Inside an mqyolo sandbox this script cannot do its job — ~/.aws there is a
# generated Bedrock-only credential dir, and the SSO token plus its cache live on
# the host — so it forwards itself to the host broker, which runs the real thing
# and restages the sandbox credentials afterwards. That means one awsAuthRefresh
# entry works both on the host and inside the sandbox.
#
# Options:
#   --no-login   Never start an interactive `aws sso login`; if the cached role
#                credentials are gone, fail with instructions instead. Forced when
#                run via the broker, where a device code could not be displayed.
#   --setup-claude
#                Write the Claude Code settings that point it at Bedrock, then
#                exit without touching any credential. See setup_claude() below.
#   --setup-codex
#                Write a Codex profile that points Codex at Bedrock, then exit
#                without touching any credential. See setup_codex() below.
#   --setup-opencode
#                Write an opencode config that points opencode at Claude on
#                Bedrock, then exit without touching any credential. See
#                setup_opencode() below.
#   --force      Let the --setup-* options overwrite existing files (a timestamped
#                backup is kept).

set -euo pipefail

NO_LOGIN=0
FORCE=0
SETUP_CLAUDE=0
SETUP_CODEX=0
CODEX_OPTS=0                     # --codex-* seen, so a missing --setup-codex can be caught
CODEX_PROFILE=bedrock            # -> $CODEX_HOME/<name>.config.toml
# Codex's own highest-priority Bedrock model. Unprefixed rather than `global.`
# or `us.`, so inference stays in REGION the way the au.* Claude models do.
CODEX_MODEL=openai.gpt-5.6-sol
SETUP_OPENCODE=0
OPENCODE_OPTS=0                  # --opencode-* seen, so a missing --setup-opencode can be caught
OPENCODE_CONFIG_NAME=bedrock     # -> $XDG_CONFIG_HOME/opencode/<name>.json
# Sonnet as opencode's default: the everyday coding model, and the au.* prefix
# keeps inference in Australia like the Claude Code settings above. Titles and
# other cheap side-tasks go to Haiku (opencode's `small_model`).
OPENCODE_MODEL=au.anthropic.claude-sonnet-5
OPENCODE_SMALL_MODEL=au.anthropic.claude-haiku-4-5-20251001-v1:0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-login) NO_LOGIN=1; shift ;;
    --force) FORCE=1; shift ;;
    --setup-claude) SETUP_CLAUDE=1; shift ;;
    --setup-codex) SETUP_CODEX=1; shift ;;
    --codex-model) CODEX_MODEL="${2:?--codex-model needs a Bedrock model id}"; CODEX_OPTS=1; shift 2 ;;
    --codex-profile) CODEX_PROFILE="${2:?--codex-profile needs a name}"; CODEX_OPTS=1; shift 2 ;;
    --setup-opencode) SETUP_OPENCODE=1; shift ;;
    --opencode-model) OPENCODE_MODEL="${2:?--opencode-model needs a Bedrock model id}"; OPENCODE_OPTS=1; shift 2 ;;
    --opencode-config) OPENCODE_CONFIG_NAME="${2:?--opencode-config needs a name}"; OPENCODE_OPTS=1; shift 2 ;;
    -h|--help)
      echo "usage: mqbedrock [--no-login]"
      echo "       mqbedrock --setup-claude [--force]"
      echo "       mqbedrock --setup-codex [--codex-model ID] [--codex-profile NAME] [--force]"
      echo "       mqbedrock --setup-opencode [--opencode-model ID] [--opencode-config NAME] [--force]"
      echo "  Top up the static [bedrock] AWS profile Claude Code reads."
      echo "  --no-login       fail with instructions instead of starting an SSO login"
      echo "  --setup-claude   write ~/.claude/settings.json (Bedrock models + this"
      echo "                   script as awsAuthRefresh) and ~/.claude.json, then exit"
      echo "                   (no AWS calls)"
      echo "  --setup-codex    write \$CODEX_HOME/<name>.config.toml so 'codex --profile"
      echo "                   <name>' runs on Bedrock, then exit (no AWS calls)"
      echo "  --codex-model    Bedrock model id to put in it (default: $CODEX_MODEL)"
      echo "  --codex-profile  Codex profile name to write (default: $CODEX_PROFILE);"
      echo "                   a non-default name needs MQYOLO_CODEX_PROFILE set for"
      echo "                   mqyolo to select it"
      echo "  --setup-opencode write \$XDG_CONFIG_HOME/opencode/<name>.json so"
      echo "                   'OPENCODE_CONFIG=<that file> opencode' runs Claude on"
      echo "                   Bedrock, then exit (no AWS calls)"
      echo "  --opencode-model Bedrock model id it defaults to (default: $OPENCODE_MODEL)"
      echo "  --opencode-config  opencode config file name to write (default:"
      echo "                   $OPENCODE_CONFIG_NAME); a non-default name needs"
      echo "                   MQYOLO_OPENCODE_CONFIG set for mqyolo to select it"
      echo "  --force          overwrite existing files the --setup-* options would"
      echo "                   otherwise refuse to touch, keeping a timestamped backup"
      exit 0 ;;
    *) echo "mqbedrock: unknown argument: $1" >&2; exit 2 ;;
  esac
done

# The --codex-* options only shape what --setup-codex writes, so on their own they
# would silently do nothing.
if [[ $CODEX_OPTS -eq 1 && $SETUP_CODEX -eq 0 ]]; then
  echo "mqbedrock: --codex-model/--codex-profile only apply with --setup-codex" >&2
  exit 2
fi
if [[ $OPENCODE_OPTS -eq 1 && $SETUP_OPENCODE -eq 0 ]]; then
  echo "mqbedrock: --opencode-model/--opencode-config only apply with --setup-opencode" >&2
  exit 2
fi
if [[ $FORCE -eq 1 && $SETUP_CLAUDE -eq 0 && $SETUP_CODEX -eq 0 && $SETUP_OPENCODE -eq 0 ]]; then
  echo "mqbedrock: --force only applies with --setup-claude/--setup-codex/--setup-opencode" >&2
  exit 2
fi

# All three --setup-* options only write config files, so they are exempt from the
# broker forwarding below and never need the refresh machinery.
SETUP_ONLY=$(( SETUP_CLAUDE || SETUP_CODEX || SETUP_OPENCODE ))

# --- Forward to the host when running inside an mqyolo sandbox ---
# MQBROKER_SPOOL is set only in the container (by mqyolo), and the shim dir on
# PATH holds an `mqbedrock` that is really mqbroker-stub. Guard against exec'ing
# ourselves in case PATH resolves back to this file.
#
# The --setup-* options are exempt: they only write config files, and ~/.claude,
# ~/.codex and ~/.config/opencode are bound read-write into the container, so they
# work from either side (~/.claude.json is staged rather than bound, so a write
# from inside the sandbox reaches the real file when mqyolo saves it back on exit).
if [[ -n "${MQBROKER_SPOOL:-}" && $SETUP_ONLY -eq 0 ]]; then
  _self=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")
  _stub=$(command -v mqbedrock 2>/dev/null || true)
  if [[ -n $_stub && $(readlink -f "$_stub" 2>/dev/null) != "$_self" ]]; then
    exec "$_stub" --no-login
  fi
  echo "mqbedrock: running inside an mqyolo sandbox, where the Bedrock credential" >&2
  echo "mqbedrock: cannot be refreshed (the SSO token and its cache are on the host)," >&2
  echo "mqbedrock: and no broker stub is available to forward to." >&2
  echo "mqbedrock: Run 'mqbedrock' on the host, then relaunch mqyolo." >&2
  exit 1
fi

umask 077                        # credentials get written; keep them 0600

CFG=$HOME/.aws/config
CREDS=$HOME/.aws/credentials     # where the static keys land (see the section on
                                 # "the static credential file" below)
CREDS_LOCK=$HOME/.aws/.mqbedrock.lock
# Seconds to wait for that lock. A write takes ~3, and Claude Code SIGTERMs an
# awsAuthRefresh hook at 3 minutes, so wait well inside that and then say so.
CREDS_LOCK_WAIT=${MQBEDROCK_LOCK_WAIT:-60}
SSO_PROFILE=bedrock-sso          # profile holding the SSO settings.
                                 # Set to "default" to reuse an existing stanza
                                 # instead of adding a second copy.
SSO_SESSION=my-sso-bedrock
STATIC_PROFILE=bedrock           # the plain profile with the static keys tools read
REGION=ap-southeast-2

# Locate the AWS CLI. It is not installed system-wide on this cluster —
# interactive shells reach it through an alias onto the central pixi
# environment, and aliases do not survive into scripts (this one normally runs
# as a Claude Code hook, with no shell rc at all). So resolve it here: a real
# aws on PATH wins, otherwise run the one from the pixi environment the alias
# points at.
PIXI_CENTRAL_TOML=${PIXI_CENTRAL_TOML:-/pkg/cmr/sw/pixi_central/pixi.toml}
if ! command -v aws >/dev/null 2>&1; then
  # pixi ships alongside this script in the deployed hpc_scripts bin directory,
  # so fall back to that when running a git checkout that has no pixi next to it.
  PIXI=$(command -v pixi || true)
  for candidate in "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/pixi" \
                   /work/microbiome/sw/hpc_scripts/bin/pixi; do
    [[ -n $PIXI ]] && break
    [[ -x $candidate ]] && PIXI=$candidate
  done
  if [[ ! -x $PIXI || ! -s $PIXI_CENTRAL_TOML ]]; then
    echo "aws not on PATH, and no pixi + $PIXI_CENTRAL_TOML to run it from" >&2
    exit 1
  fi
  aws() { "$PIXI" run --manifest-path "$PIXI_CENTRAL_TOML" aws "$@"; }
fi

# Section header for a profile: "default" has no prefix, everything else does.
sec() { [[ $1 == default ]] && echo "default" || echo "profile $1"; }

# cfg_get FILE SECTION KEY — print the value of KEY within [SECTION] of FILE.
# Written by hand rather than using `aws configure get` because that resolves
# sso_session indirection and can't read [sso-session ...] blocks at all.
cfg_get() {
  [[ -s $1 ]] || return 1
  awk -v s="[$2]" -v k="$3" '
    # Track which section we are in; trailing whitespace on headers is common.
    /^[ \t]*\[/ { gsub(/[ \t]+$/,""); insec = ($0 == s); next }
    # Match "key=value" and "key = value" without matching a longer key
    # that merely starts with the same characters.
    insec && index($0, k"=") == 1 || insec && index($0, k" ") == 1 {
      sub(/^[^=]*=[ \t]*/, ""); gsub(/[ \t]+$/,""); print; exit }
  ' "$1"
}

# want SECTION KEY VALUE — assert a $CFG entry, reporting what was found.
# Checks values, not just presence: a stale sso_role_name otherwise fails much
# later, during the credential fetch, with an error that doesn't point back here.
want() {
  local got; got=$(cfg_get "$CFG" "$1" "$2" || true)
  [[ $got == "$3" ]] || { echo "  [$1] $2 = $3   (found: ${got:-missing})" >&2; return 1; }
}

# Append the stanzas needed for Bedrock. Only ever called on an empty config,
# so this never has to worry about clobbering existing entries.
bootstrap() {
  cat >> "$CFG" <<EOF

[$(sec "$SSO_PROFILE")]
sso_session = $SSO_SESSION
sso_account_id = 267451755618
sso_role_name = DFAZCB7230-BedrockUserAccess
region = $REGION
output = json

[sso-session $SSO_SESSION]
sso_start_url = https://d-97671c4bd0.awsapps.com/start
sso_region = $REGION
sso_registration_scopes = sso:account:access

[$(sec "$STATIC_PROFILE")]
region = $REGION
EOF
}

# Verify an existing config has everything needed, collecting all problems
# rather than stopping at the first so one run reports the full list.
check() {
  local ok=0
  want "$(sec "$SSO_PROFILE")" sso_session    "$SSO_SESSION"                 || ok=1
  want "$(sec "$SSO_PROFILE")" sso_account_id 267451755618                   || ok=1
  want "$(sec "$SSO_PROFILE")" sso_role_name  DFAZCB7230-BedrockUserAccess   || ok=1
  want "sso-session $SSO_SESSION" sso_start_url https://d-97671c4bd0.awsapps.com/start || ok=1
  want "sso-session $SSO_SESSION" sso_region   "$REGION"                      || ok=1
  # Without this scope Identity Center issues no refresh token at all.
  want "sso-session $SSO_SESSION" sso_registration_scopes sso:account:access || ok=1
  # Claude Code needs a region on the profile it actually reads.
  want "$(sec "$STATIC_PROFILE")" region "$REGION"                           || ok=1
  return $ok
}

# --- Claude Code on Bedrock (--setup-claude) -------------------------------
# The two files a fresh account needs before Claude Code will talk to Bedrock:
#
#   ~/.claude/settings.json  turns Bedrock on, names the region and the static
#                            profile this script maintains, pins the au.* (data
#                            stays in Australia) inference-profile IDs, and wires
#                            this script in as awsAuthRefresh so an expired key is
#                            renewed automatically — including inside an mqyolo
#                            sandbox, where the mqbedrock on PATH is the broker stub.
#   ~/.claude.json           just the onboarding flag, so the first run does not
#                            open the interactive theme/login walkthrough (which in
#                            a sandbox is a dead end: there is nothing to log into
#                            when the credential is an AWS profile).
#
# Both are the user's own files, so an existing one is only replaced when it is
# already equivalent (same JSON, key order and whitespace irrelevant) or --force
# says so. ~/.claude.json in particular accumulates real state — project history,
# onboarding answers, MCP approvals — so overwriting keeps a backup.
CLAUDE_SETTINGS_JSON=$(cat <<EOF
{
  "awsAuthRefresh": "mqbedrock",
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "$REGION",
    "AWS_PROFILE": "$STATIC_PROFILE",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "au.anthropic.claude-sonnet-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "au.anthropic.claude-opus-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "au.anthropic.claude-haiku-4-5-20251001-v1:0"
  }
}
EOF
)

CLAUDE_JSON=$(cat <<'EOF'
{
  "hasCompletedOnboarding": true
}
EOF
)

# json_equal FILE JSON — true when FILE parses to the same JSON value, so
# formatting and key order do not matter. jq or python3, whichever this host has;
# with neither, say "different" so an existing file is never clobbered blindly.
json_equal() {
  if command -v jq >/dev/null 2>&1; then
    jq -e --argjson want "$2" '. == $want' "$1" >/dev/null 2>&1
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys
sys.exit(0 if json.load(open(sys.argv[1])) == json.loads(sys.argv[2]) else 1)' \
      "$1" "$2" 2>/dev/null
  else
    return 1
  fi
}

# Keep a timestamped copy before --force replaces a file the user may care about.
backup_file() {
  local backup="${1}.mqbedrock-$(date +%Y%m%d%H%M%S).bak"
  cp -p "$1" "$backup"
  echo "backed up $1 -> $backup"
}

# write_json FILE JSON OPTION — write JSON to FILE unless FILE already exists with
# different contents. Refuses in that case, naming the OPTION that wanted to write
# it; --force overwrites, keeping a timestamped backup.
write_json() {
  local file="$1" want="$2" option="$3"
  if [[ -e $file ]]; then
    if json_equal "$file" "$want"; then
      echo "$file already holds these settings"
      return 0
    fi
    if [[ $FORCE -eq 0 ]]; then
      echo "mqbedrock: $file already exists and differs from what $option" >&2
      echo "mqbedrock: would write, so it is left alone. Merge the settings by hand," >&2
      echo "mqbedrock: or re-run with --force to overwrite it (a backup is kept)." >&2
      return 1
    fi
    backup_file "$file"
  fi
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$want" > "$file"
  echo "wrote $file"
}

setup_claude() {
  local ok=0
  write_json "$HOME/.claude/settings.json" "$CLAUDE_SETTINGS_JSON" --setup-claude || ok=1
  write_json "$HOME/.claude.json"          "$CLAUDE_JSON"          --setup-claude || ok=1
  [[ $ok -eq 0 ]] || return 1
  echo "  Bedrock via the [$STATIC_PROFILE] profile in $REGION; run 'mqbedrock' to fill"
  echo "  it in (Claude Code then refreshes it itself via awsAuthRefresh)."
  echo "  'mqbedrock' must be on PATH for that hook — the CMR bashrc extras do this."
}

# --- Codex on Bedrock (--setup-codex) --------------------------------------
# Codex speaks only the OpenAI protocol, so it does not reach Claude on Bedrock
# at all: it uses Bedrock's OpenAI-compatible endpoint
# (bedrock-runtime.<region>.amazonaws.com/openai/v1, the built-in
# `amazon-bedrock-runtime` provider) and runs the OpenAI models hosted there.
# That endpoint accepts SigV4, so it can sign with the very same static
# [bedrock] profile this script maintains for Claude Code.
#
# `amazon-bedrock-runtime` rather than `amazon-bedrock`: the latter is the
# bedrock-mantle endpoint, which is not offered in every region (ap-southeast-2
# included), while the runtime endpoint is regional everywhere.
#
# The settings go in their own $CODEX_HOME/<name>.config.toml profile layer
# rather than into config.toml, because that file is then entirely ours (no
# risk of mangling a config.toml full of project trust entries), it only takes
# effect under `codex --profile <name>` so the user's default Codex setup is
# untouched, and — unlike a project-local config — a profile layer is allowed
# to set provider and auth keys.
CODEX_MARKER="# Generated by 'mqbedrock --setup-codex'; re-running that overwrites this file."

# CODEX_HOME is honoured because that is where Codex itself looks. Note mqyolo
# only ever reads ~/.codex, since that is the directory it binds into the
# container — so a CODEX_HOME elsewhere works for codex on the host but leaves
# mqyolo nothing to select.
codex_profile_file() {
  echo "${CODEX_HOME:-$HOME/.codex}/${CODEX_PROFILE}.config.toml"
}

# The region to sign for: whatever the static profile actually uses, falling
# back to the one bootstrap writes.
profile_region() {
  local r; r=$(cfg_get "$CFG" "$(sec "$STATIC_PROFILE")" region || true)
  echo "${r:-$REGION}"
}

codex_profile_toml() {
  cat <<EOF
$CODEX_MARKER
#
# Codex on Amazon Bedrock. Use it with:  codex --profile ${CODEX_PROFILE}
# mqyolo adds that flag itself when it launches codex.
# Change the model with: mqbedrock --setup-codex --codex-model <id>

model_provider = "amazon-bedrock-runtime"
model = "${CODEX_MODEL}"

[model_providers.amazon-bedrock-runtime.aws]
profile = "${STATIC_PROFILE}"
region = "$(profile_region)"

# Codex's equivalent of Claude Code's awsAuthRefresh hook: the static keys in
# the profile above expire (12h for an SSO-issued role), and this is run to mint
# new ones when signing starts failing. Inside an mqyolo sandbox the mqbedrock
# on PATH is the broker stub, so the refresh happens on the host — the only
# place it can — and the sandbox credentials are restaged afterwards.
[model_providers.amazon-bedrock-runtime.aws.auth_refresh]
command = "mqbedrock"
EOF
}

setup_codex() {
  local file new
  file=$(codex_profile_file)
  mkdir -p "$(dirname "$file")"
  # Never clobber a file we did not write: an unmarked one is the user's own.
  if [[ -e $file ]] && ! grep -qF "$CODEX_MARKER" "$file"; then
    if [[ $FORCE -eq 0 ]]; then
      echo "mqbedrock: $file already exists and was not written by --setup-codex," >&2
      echo "mqbedrock: so it is left alone. Choose another name with --codex-profile" >&2
      echo "mqbedrock: NAME, or re-run with --force to overwrite it (a backup is kept)." >&2
      return 1
    fi
    backup_file "$file"
  fi
  new=$(codex_profile_toml)
  if [[ -e $file && "$(cat "$file")" == "$new" ]]; then
    echo "codex profile $file already up to date (model $CODEX_MODEL)"
    return 0
  fi
  printf '%s\n' "$new" > "$file"
  echo "wrote $file"
  echo "  provider amazon-bedrock-runtime, model $CODEX_MODEL, region $(profile_region),"
  echo "  signing with the [$STATIC_PROFILE] profile (run 'mqbedrock' to fill it in)."
  echo "  Use it with 'codex --profile $CODEX_PROFILE'; mqyolo codex selects it for you."
  echo
  echo "NOTE: the Bedrock OpenAI-compatible endpoint authorizes InvokeModel against"
  echo "      arn:aws:bedrock:$(profile_region):<account>:project/default, which QUT's"
  echo "      BedrockUserAccess role does not currently grant — Codex will fail with"
  echo "      AccessDeniedException until that permission is added. Claude on Bedrock"
  echo "      is unaffected: it uses the per-model Converse API, which is allowed."
}

# --- opencode on Bedrock (--setup-opencode) --------------------------------
# opencode, unlike Codex, does reach Claude on Bedrock: its built-in
# `amazon-bedrock` provider is the @ai-sdk/amazon-bedrock client, which calls the
# per-model Converse API — the same one Claude Code uses, and the one QUT's
# BedrockUserAccess role actually grants. So the au.* inference profiles from
# setup_claude() work here too, signed with the same static [bedrock] profile.
#
# The settings go in their own opencode config file rather than into
# opencode.json, selected with OPENCODE_CONFIG=<file> (which opencode loads as an
# ADDITIONAL layer over the global config, winning on the keys it sets). Same
# reasoning as the Codex profile file: the file is then entirely ours, and it
# changes nothing until something points OPENCODE_CONFIG at it — which mqyolo
# does when it launches opencode.
#
# Plain JSON with no comments even though opencode's loader accepts JSONC: mqyolo
# reads the AWS profile back out of this file with a JSON parser, and write_json
# below compares an existing file as JSON so a user's own (or a comment-carrying)
# file is never silently replaced. The "//" key is the conventional JSON comment;
# opencode ignores keys it does not know.
#
# XDG_CONFIG_HOME is honoured because that is where opencode itself looks. Note
# mqyolo only ever reads ~/.config/opencode, since that is the directory it binds
# into the container — so a config written elsewhere works for opencode on the
# host but leaves mqyolo nothing to select.
opencode_config_file() {
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/${OPENCODE_CONFIG_NAME}.json"
}

opencode_config_json() {
  cat <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "//": "Generated by 'mqbedrock --setup-opencode'. Select it with OPENCODE_CONFIG=<this file>; mqyolo does that when it launches opencode. Re-running that command overwrites this file.",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "profile": "$STATIC_PROFILE",
        "region": "$(profile_region)"
      }
    }
  },
  "model": "amazon-bedrock/${OPENCODE_MODEL}",
  "small_model": "amazon-bedrock/${OPENCODE_SMALL_MODEL}"
}
EOF
}

setup_opencode() {
  local file
  file=$(opencode_config_file)
  write_json "$file" "$(opencode_config_json)" --setup-opencode || return 1
  echo "  provider amazon-bedrock (Converse API), model $OPENCODE_MODEL,"
  echo "  region $(profile_region), signing with the [$STATIC_PROFILE] profile"
  echo "  (run 'mqbedrock' to fill it in). opencode has no auth-refresh hook of its"
  echo "  own, so an expired key means running 'mqbedrock' again — on the host, or"
  echo "  from inside an mqyolo sandbox, where it is forwarded to the host."
  echo "  Use it with 'OPENCODE_CONFIG=$file opencode'; mqyolo opencode selects it for you."
}

# --- The static credential file --------------------------------------------
# `aws configure set` is an unlocked read-modify-write. It reads the whole file,
# rewrites it in place through open(..., 'w') — so there is a window in which the
# file is truncated — and when the section is not in what it read it *appends* a
# fresh `[section]` header rather than failing. Two overlapping writers therefore
# leave two `[bedrock]` sections behind, and from then on botocore's parser
# rejects the entire file: "Unable to parse config file: ~/.aws/credentials".
# That breaks every AWS call, including the ones this script would need to make
# to put things right, so the only way out was to move the file aside by hand.
#
# Overlapping writers are the normal case here, not a rare one: every consumer of
# the profile shares a single deadline, because the 12h role credential expires
# for all of them at the same instant. Each Claude Code session's awsAuthRefresh
# — host sessions, plus one per mqyolo broker forwarding it — then fires within
# seconds of the others and runs the three writes below in lockstep. So serialise
# our own writes, and repair the file if something got in anyway.

# with_creds_lock CMD... — run CMD holding an exclusive lock. The lock is its own
# file rather than the credentials file, so it does not depend on how awscli opens
# its target (it replaces the contents; a repair below replaces the inode).
with_creds_lock() {
  mkdir -p "$(dirname "$CREDS_LOCK")"
  (
    if ! flock -w "$CREDS_LOCK_WAIT" 9; then
      echo "mqbedrock: something still holds $CREDS_LOCK after ${CREDS_LOCK_WAIT}s;" >&2
      echo "mqbedrock: giving up rather than racing it into a corrupt credentials file." >&2
      echo "mqbedrock: If no other mqbedrock is running, delete that lock file." >&2
      exit 4
    fi
    "$@"
  ) 9>"$CREDS_LOCK"
}

# creds_sections — how many [STATIC_PROFILE] headers the credentials file holds.
# Exactly one is correct; more is the corruption described above.
creds_sections() {
  [[ -s $CREDS ]] || { echo 0; return 0; }
  grep -cE "^[[:blank:]]*\[$STATIC_PROFILE\][[:blank:]]*\$" "$CREDS" || true
}

# collapse_creds_section — print the credentials file with its duplicate
# [STATIC_PROFILE] sections merged into the first one (last value for a key wins,
# i.e. the most recent write), every other byte left exactly as it was. Comments
# and blank lines stay where they are, including inside the section: a comment
# just above the next header parses as ours but plainly is not. Two passes over
# the file: gather, then emit.
collapse_creds_section() {
  awk -v sec="[$STATIC_PROFILE]" '
    function header(l) { sub(/[ \t]+$/, "", l); return l }
    function is_prose(l) { return (l == "" || l ~ /^[ \t]*[#;]/) }
    FNR == NR {                                   # pass 1: collect the keys
      line = header($0)
      if (line ~ /^[ \t]*\[/) { insec = (line == sec); next }
      if (!insec || is_prose(line)) next
      key = line; sub(/[ \t]*=.*/, "", key)
      if (!(key in value)) order[++n] = key
      value[key] = $0                             # raw line: keep its spacing
      next
    }
    {                                             # pass 2: emit one section
      line = header($0)
      if (line ~ /^[ \t]*\[/) {
        insec = (line == sec)
        if (!insec) { print; next }
        if (++seen == 1) {
          print
          for (i = 1; i <= n; i++) print value[order[i]]
        }
        next
      }
      if (!insec || is_prose(line)) print
    }
  ' "$CREDS" "$CREDS"
}

# repair_creds — undo a duplicated [STATIC_PROFILE] section, so a file corrupted
# by a concurrent write heals on the next run instead of needing a human. Only our
# own section is rewritten, and only when every line in it is a plain
# `key = value` (all we ever put there); anything more interesting is reported
# rather than guessed at, since this file can hold other profiles' long-lived keys.
repair_creds() {
  local n; n=$(creds_sections)
  (( n > 1 )) || return 0
  echo "mqbedrock: $CREDS holds $n [$STATIC_PROFILE] sections, which no AWS tool can" >&2
  echo "mqbedrock: parse — a concurrent write left them. Collapsing them into one." >&2
  if ! awk -v sec="[$STATIC_PROFILE]" '
        { line = $0; sub(/[ \t]+$/, "", line) }
        line ~ /^[ \t]*\[/ { insec = (line == sec); next }
        line == "" || line ~ /^[ \t]*[#;]/ { next }
        insec && line !~ /^[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*[^ \t]/ { bad = 1 }
        END { exit(bad ? 1 : 0) }
      ' "$CREDS"; then
    echo "mqbedrock: ...except one of them holds something other than plain key = value" >&2
    echo "mqbedrock: entries, so this is not ours to rewrite. Merge them by hand." >&2
    return 1
  fi
  backup_file "$CREDS" >&2
  local tmp; tmp=$(mktemp "$CREDS.mqbedrock-XXXXXX")
  collapse_creds_section > "$tmp"
  mv -f "$tmp" "$CREDS"          # atomic, so no reader sees a half-written file
}

# write_static_keys — copy the fetched credentials into [STATIC_PROFILE]. Called
# under the lock; `creds` is the JSON fetched below.
write_static_keys() {
  aws configure set aws_access_key_id     "$(jq -r .AccessKeyId     <<<"$creds")" --profile "$STATIC_PROFILE"
  aws configure set aws_secret_access_key "$(jq -r .SecretAccessKey <<<"$creds")" --profile "$STATIC_PROFILE"
  aws configure set aws_session_token     "$(jq -r .SessionToken    <<<"$creds")" --profile "$STATIC_PROFILE"
  # Under the lock our own three writes cannot collide, so a duplicate at this
  # point means a writer that does not take it — a hand-run `aws configure set`,
  # or another tool. Report it now: left alone it resurfaces later as a parse
  # error that points at the file rather than at whatever wrote it.
  local n; n=$(creds_sections)
  if (( n != 1 )); then
    echo "mqbedrock: wrote the keys, but $CREDS now holds $n [$STATIC_PROFILE] sections" >&2
    echo "mqbedrock: instead of 1 — something outside this script wrote it at the same" >&2
    echo "mqbedrock: time. Re-run mqbedrock to collapse them." >&2
    return 1
  fi
}

# The --setup-* options only write config files: no AWS config check, no
# credentials, no network — so they also work before the profile has ever been
# filled in, and any order of the setup steps is fine. Several may be given at
# once; the exit status covers all of them.
if [[ $SETUP_ONLY -eq 1 ]]; then
  setup_rc=0
  if [[ $SETUP_CLAUDE   -eq 1 ]]; then setup_claude   || setup_rc=1; fi
  if [[ $SETUP_CODEX    -eq 1 ]]; then setup_codex    || setup_rc=1; fi
  if [[ $SETUP_OPENCODE -eq 1 ]]; then setup_opencode || setup_rc=1; fi
  exit $setup_rc
fi

mkdir -p "$(dirname "$CFG")"
if [[ ! -s $CFG ]]; then
  bootstrap                      # fresh machine: write the config ourselves
elif ! check; then
  echo "$CFG is missing the entries above; add them or delete the conflicting keys" >&2
  exit 1                         # never edit a config that has other entries in it
fi

# Heal a credentials file a concurrent write corrupted, before the first AWS call
# rather than just before our own write: every command below reads that file, so a
# duplicated section otherwise fails the fetch — and then the login it falls
# through to, which is where the parse error finally becomes visible.
with_creds_lock repair_creds

# Fetch credentials. Normally served from ~/.aws/cli/cache without touching the
# network; falls through to a login only once the full 12h has elapsed.
if ! creds=$(aws configure export-credentials --profile "$SSO_PROFILE" --format process 2>/dev/null); then
  # Past the 12h window the cache is empty and the SSO session is gone, so a new
  # credential needs an interactive device-code approval in a browser. Under
  # --no-login (i.e. run via the mqyolo broker) there is nowhere to show the code
  # and nobody to approve it, so say what to do instead of blocking on a poll.
  if [[ $NO_LOGIN -eq 1 ]]; then
    echo "mqbedrock: the SSO session has expired and the cached role credentials are gone," >&2
    echo "mqbedrock: so a new one needs an interactive login that cannot be done from here." >&2
    echo "mqbedrock: Run 'mqbedrock' in a terminal on the host and approve the device code;" >&2
    echo "mqbedrock: this session then picks up the new credentials automatically." >&2
    exit 3
  fi
  # Device code rather than the browser flow: BROWSER=echo just prints the URL.
  # Set here, not at the caller — the hook doesn't inherit your shell's env.
  # Note Claude Code shows this output but accepts no input, so complete the
  # login in a browser while it polls.
  BROWSER=echo aws sso login --profile "$SSO_PROFILE" --use-device-code
  creds=$(aws configure export-credentials --profile "$SSO_PROFILE" --format process)
fi

# Copy into [bedrock] as plain static keys. Claude Code re-resolves these about
# hourly, but that is now a local file read rather than an Identity Center call.
# Codex (see setup_codex) signs the Bedrock OpenAI-compatible endpoint with the
# same profile. Under the lock, so two sessions refreshing at the same moment
# cannot interleave awscli's read-modify-write into a duplicated section.
with_creds_lock write_static_keys

echo "$STATIC_PROFILE profile refreshed, expires $(jq -r .Expiration <<<"$creds")"
