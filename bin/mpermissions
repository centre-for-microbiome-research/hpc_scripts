import argparse
import logging
import subprocess
import os
import grp
import stat
import sys
from argparse import RawTextHelpFormatter

def run(command, stdin=None):
    '''
    Run a subprocess.check_output() with the given command with
    'bash -c command'
    returning the stdout. If the command fails (i.e. has a non-zero exitstatus),
    raise a ExternCalledProcessError that includes the $stderr as part of
    the error message

    Parameters
    ----------
    command: str
        command to run
    stdin: str or None
        stdin to be provided to the process, to subprocess.communicate.

    Returns
    -------
    Standard output of the run command

    Exceptions
    ----------
    extern.ExternCalledProcessError including stdout and stderr of the run
    command should it return with non-zero exit status.
    '''
    #logging.debug("Running extern cmd: %s" % command)

    using_stdin = stdin is not None
    process = process = subprocess.Popen(
        ["bash",'-o','pipefail',"-c", command],
        stdin= (subprocess.PIPE if using_stdin else None),
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    stdout, stderr = process.communicate(stdin)

    if process.returncode != 0:
        raise ExternCalledProcessError(process, command, stdout.decode(), stderr.decode())
    return stdout

class ExternCalledProcessError(subprocess.CalledProcessError):
    def __init__(self, completed_process, command, stdout, stderr):
        self.command = command
        self.returncode = completed_process.returncode
        self.stderr = stderr
        self.stdout = stdout
        self.completed_process = completed_process

    def __str__(self):
        return "Command %s returned non-zero exit status %i.\n"\
            "STDERR was: %sSTDOUT was: %s" % (
                self.command,
                self.returncode,
                self.stderr,
                self.stdout)

# /mnt/weka/pkg (weka) does not take POSIX ACLs, so paths there get plain
# chgrp/chmod. Overridable only so the tests can point it at a temp dir.
WEKA_PREFIX = os.environ.get('MPERMISSIONS_WEKA_PREFIX', '/mnt/weka/pkg')

S_RWX_O = stat.S_IROTH | stat.S_IWOTH | stat.S_IXOTH
S_ANY_X_UG = stat.S_IXUSR | stat.S_IXGRP


def desired_mode(mode, is_dir, group_write, other_read):
    '''The mode a path should end up with, given its current mode. Mirrors
    what the chmod commands of the ACL-free (weka) path used to apply.'''
    m = mode
    if is_dir:
        m |= stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_ISGID
        if group_write:
            m |= stat.S_IWGRP
        if other_read:
            m = (m | stat.S_IROTH | stat.S_IXOTH) & ~stat.S_IWOTH
        else:
            m &= ~S_RWX_O
    else:
        executable = bool(mode & S_ANY_X_UG)
        m |= stat.S_IRUSR | stat.S_IWUSR | stat.S_IRGRP
        if group_write:
            m |= stat.S_IWGRP
        if other_read:
            m = (m | stat.S_IROTH) & ~(stat.S_IWOTH | stat.S_IXOTH)
        else:
            m &= ~S_RWX_O
        if executable:
            m |= stat.S_IXGRP
            if other_read:
                m |= stat.S_IXOTH
    return m


def fix_without_acls(folder, gid, group_write, other_read, dry_run, no_continue):
    '''chgrp/chmod every path under folder, but only where the group or mode
    is actually wrong. chmod(2) and chown(2) fail with EPERM for anyone but the
    owner even when they would change nothing, so running them unconditionally
    made every already-correct path owned by someone else a failure - and a
    shared tree (e.g. an mqpixi env installed by another admin) could never
    come back clean. Paths that genuinely need a change and that we do not own
    still fail, and are reported.

    Failures on .pyc files are not reported: Python writes them into
    __pycache__ at import time as whoever happens to run the tool, with that
    user's umask, so a shared env collects other-owned ones that no deployer
    can fix - and they are only a cache, regenerated (or skipped) if they
    cannot be read. They are still fixed where possible, and counted.

    Returns the list of (path, error) failures.'''
    failures = []
    ignored_pyc = [0]
    counts = {'chgrp': 0, 'chmod': 0}

    def fail(path, err):
        if path and str(path).endswith('.pyc'):
            ignored_pyc[0] += 1
            return
        failures.append((path, err))
        if no_continue:
            raise err

    def fix(path, dir_walked):
        try:
            st = os.lstat(path)
        except OSError as e:
            fail(path, e)
            return
        if st.st_gid != gid:
            counts['chgrp'] += 1
            if dry_run:
                logging.info('Would chgrp: {}'.format(path))
            else:
                try:
                    os.chown(path, -1, gid, follow_symlinks=False)
                    # chown may clear the setgid bit, so recompute from the new mode.
                    st = os.lstat(path)
                except OSError as e:
                    fail(path, e)
        # Like the find -type d / -type f commands this replaces: symlinks and
        # special files get their group fixed but no chmod.
        if stat.S_ISDIR(st.st_mode) and dir_walked:
            is_dir = True
        elif stat.S_ISREG(st.st_mode):
            is_dir = False
        else:
            return
        current = stat.S_IMODE(st.st_mode)
        wanted = desired_mode(current, is_dir, group_write, other_read)
        if wanted != current:
            counts['chmod'] += 1
            if dry_run:
                logging.info('Would chmod {:o} -> {:o}: {}'.format(current, wanted, path))
            else:
                try:
                    os.chmod(path, wanted)
                except OSError as e:
                    fail(path, e)

    def walk_error(e):
        fail(e.filename, e)

    if os.path.isdir(folder) and not os.path.islink(folder):
        for dirpath, dirnames, filenames in os.walk(folder, onerror=walk_error):
            fix(dirpath, True)
            for name in filenames:
                fix(os.path.join(dirpath, name), False)
            # os.walk lists symlinks to directories here but does not descend.
            for name in dirnames:
                p = os.path.join(dirpath, name)
                if os.path.islink(p):
                    fix(p, False)
    else:
        fix(folder, False)

    logging.info('{} {} path(s) needed chgrp, {} needed chmod'.format(
        'Dry run:' if dry_run else 'Done:', counts['chgrp'], counts['chmod']))
    if ignored_pyc[0]:
        logging.info('Ignored {} .pyc file(s) that could not be fixed (bytecode cache; '
                     'not counted as a failure)'.format(ignored_pyc[0]))
    return failures


## TODO: Code below copied from the mqsub script. Code shouldn't really be copied but imported.

#%% parse
if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='''
    Apply the correct group permissions to a directory.
    Example: mpermissions -g microbiome <dir_name>
    ''',formatter_class=RawTextHelpFormatter)
    parser.add_argument('folder',help='folder to apply permissions to')
    parser.add_argument('-g', help='Add permissions for this group', required=True)
    parser.add_argument('--no-continue', help='Do not keep running commands after one fails', action='store_true')
    parser.add_argument('--no-group-write', help='Do not add group write permissions', action='store_true')
    parser.add_argument('--other-read', help='Instead of removing all access for users outside the group, '
                        'give them read (and execute where the owner/group have it) but never write. '
                        'Use for shared software trees (e.g. mqpixi environments) that everyone must be able to run '
                        'but only the group may modify.', action='store_true')
    parser.add_argument('--dry-run', help='Do not actually run commands', action='store_true')
    args = parser.parse_args()

    logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s: %(message)s', datefmt='%m/%d/%Y %I:%M:%S %p')

    folder=args.folder
    owner_group=args.g
    # owner_user=run('whoami').strip()
    logging.info("Setting permissions on folder {} for group {}".format(folder,owner_group))
    folder2 = "'{}'".format(folder)

    ## Create test set
    # mkdir -p test/dir && touch test/file && touch test/dir/file && chmod +x test/dir/file
    ## Run test
    # ~/src/hpc_scripts/bin/mpermissions -g microbiome test
    # ls -alh . && ls -alh test && ls -alh test/dir && getfacl test/file && getfacl test/dir/file

    # The commands below are the POSIX ACL path; folders on weka, which does
    # not take ACLs, are handled by fix_without_acls instead.
    dir_group_permissions = 'rwx'
    file_group_permissions = 'rw'
    if args.no_group_write:
        dir_group_permissions = 'r-x'
        file_group_permissions = 'r-'
    # ACL permissions for users who are neither the owner nor in the group,
    # for dirs / plain files / executables.
    if args.other_read:
        other_acl_dir = 'r-x'
        other_acl_file = 'r--'
        other_acl_exec = 'r-x'
    else:
        other_acl_dir = '---'
        other_acl_file = '---'
        other_acl_exec = '---'
    # Loop over "$@": find ... -exec {} + passes many directories per bash
    # invocation, and handling only "$1" silently skipped all but the first.
    cmd1 = (
        "find {} -type d -exec bash -c '".format(folder2) +
        "for dir in \"$@\"; do "
        "setfacl -dm g:microbiome-admin:rwx,g::{},u::rwx,o::{} \"$dir\"; ".format(dir_group_permissions, other_acl_dir) +
        "setfacl -m g:microbiome-admin:rwx,g::{},u::rwx,o::{} \"$dir\"; ".format(dir_group_permissions, other_acl_dir) +
        "done' _ {} +"
    )
    cmd2 = (
        "find {} -type f -exec bash -c '".format(folder2) +
        "for file in \"$@\"; do "
        "if [ -x \"$file\" ]; then "
        "setfacl -m g:microbiome-admin:rwx,g::{}x,u::rwx,m::rwx,o::{} \"$file\"; ".format(file_group_permissions, other_acl_exec) +
        "else "
        "setfacl -m g:microbiome-admin:rw-,g::{}-,u::rw-,m::rw-,o::{} \"$file\"; ".format(file_group_permissions, other_acl_file) +
        "fi; "
        "done' _ {} +"
    )
    # chgrp and chmod g+s, only where needed: chgrp/chmod fail for non-owners even when nothing changes.
    cmd3 = "find {} ! -group '{}' -exec chgrp -h '{}' {{}} +".format(folder2, owner_group, owner_group)
    cmd4 = 'find {} -type d ! -perm -g+s -exec chmod g+s {{}} +'.format(folder2)

    if not os.path.exists(folder):
        raise Exception("Folder {} does not exist".format(folder))

    # find does not follow symlinks below the folder, so whether a path is on
    # weka is decided by the folder itself.
    real_folder = os.path.realpath(folder)
    if real_folder == WEKA_PREFIX or real_folder.startswith(WEKA_PREFIX.rstrip('/') + '/'):
        try:
            gid = grp.getgrnam(owner_group).gr_gid
        except KeyError:
            logging.error("CMD FAILED: unknown group {}".format(owner_group))
            sys.exit(1)
        logging.info("{} is on weka (no ACLs): fixing group and mode only where they differ".format(real_folder))
        failures = fix_without_acls(real_folder, gid, not args.no_group_write, args.other_read,
                                    args.dry_run, args.no_continue)
        if failures:
            # deploy_to_production.sh judges a run by this string in the output.
            logging.error("CMD FAILED: could not fix {} path(s) under {}; only the owner of a "
                          "path can change it, so its owner must run this".format(len(failures), real_folder))
            for path, err in failures[:20]:
                logging.error("  {}: {}".format(path, err.strerror or err))
            if len(failures) > 20:
                logging.error("  ... and {} more".format(len(failures) - 20))
        sys.exit(0)

    for cmd in [cmd1, cmd2, cmd3, cmd4]:
        logging.info('Running: {}'.format(cmd))

        if not args.dry_run:
            try:
                run(cmd)
            except ExternCalledProcessError as e:
                if args.no_continue:
                    logging.error("Not continuing to run further commands due to --no-continue")
                    raise e

                logging.error("CMD FAILED: {}".format(cmd))
                logging.error(e)
                logging.error("Command failed: {}".format(cmd))
                logging.error("Command stdout: {}".format(e.stdout))
                logging.error("Command stderr: {}".format(e.stderr))
                logging.error("Command return code: {}".format(e.returncode))
                logging.error("Command completed process: {}".format(e.completed_process))

                logging.info("Continuing with other commands, if there are any ..")
