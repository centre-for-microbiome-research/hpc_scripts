#!/bin/bash
# mqpixi - drop into a pixi shell for one of the centrally maintained CMR tool
# environments defined in /pkg/cmr/mqpixi/pixi.toml, replacing per-tool conda
# envs under /pkg/cmr/conda/envs/ (which are hard to keep patched/maintained).
#
# Usage:
#   mqpixi <environment-name>
#
# Example:
#   mqpixi checkm2-v1.0.2

set -euo pipefail

CMR_PIXI_TOML="${CMR_PIXI_TOML:-/pkg/cmr/mqpixi/pixi.toml}"

print_usage() {
    echo "Usage: mqpixi <environment-name>"
    echo "e.g.:  mqpixi checkm2-v1.0.2"
    echo
    echo "Drops into a pixi shell for one of the centrally maintained CMR tool"
    echo "environments defined in $CMR_PIXI_TOML."
    echo
    echo "<environment-name> may be an exact environment name, or a bare program"
    echo "name (e.g. singlem), in which case the most recent versioned"
    echo "environment for that program is selected automatically."
    echo
    echo "Any extra arguments after <environment-name> are passed through to"
    echo "'pixi shell' as the command to run instead of an interactive shell."
    echo
    echo "Available environments:"
    awk '/^\[environments\]/ { found=1; next } /^\[/ { found=0 } found && /^[a-z0-9-]+ = / { print "  " $1 }' "$CMR_PIXI_TOML"
}

if [[ $# -lt 1 ]]; then
    print_usage
    exit 1
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    print_usage
    exit 0
fi

env_name="$1"
shift

# pixi environment names may only contain lowercase letters, digits and
# dashes, but /pkg/cmr/conda/envs/ names contain dots and underscores
# (e.g. checkm2-v1.0.2, fastx_toolkit-v0.0.14) - translate to match the
# sanitized names used as environment keys in pixi.toml.
env_name="${env_name//./-}"
env_name="${env_name//_/-}"

# All environment names defined in the manifest.
list_environments() {
    awk '/^\[environments\]/ { found=1; next } /^\[/ { found=0 } found && /^[a-z0-9-]+ = / { print $1 }' "$CMR_PIXI_TOML"
}

# If there is no environment matching the requested name exactly, treat the
# name as a program name and pick the most recent versioned environment. The
# convention is <program_name>-v<version_with_dashes_instead_of_dots>, e.g.
# `mqpixi singlem` resolves to singlem-v0-21-3 when singlem-v0-18-3 also exists.
if ! list_environments | grep -qxF "$env_name"; then
    # Extract the version suffix, translate dashes back to dots so `sort -V`
    # orders them numerically, then pick the highest and reconstruct the name.
    latest_version="$(list_environments \
        | sed -n "s/^${env_name}-v\(.*\)$/\1/p" \
        | tr '-' '.' \
        | sort -V \
        | tail -n1)"
    if [[ -n "$latest_version" ]]; then
        env_name="${env_name}-v${latest_version//./-}"
    fi
fi

# Aviary drives its own PBS submissions via the aqua snakemake profile, so
# wrapping the whole run in a single mqsub job wastes a large allocation while
# the workflow serializes. Nudge users towards the profile instead.
if [[ "$env_name" == aviary || "$env_name" == aviary-* ]]; then
    echo "NOTE: Please run aviary using 'aviary .. --snakemake-profile aqua --request-gpu ..' rather than 'mqsub .. -- aviary ..'. This will help your jobs run faster and it is better for overall cluster utilisation. See the aviary section of https://tinyurl.com/cmr-internal-compute for more details." >&2
    echo "NOTE: You probably want to use the --request-gpu option, so that Aviary utilizes available GPUs, when binning programs (e.g. SemiBin2) can make use of them. Your jobs will run faster." >&2
fi

exec pixi shell --manifest-path "$CMR_PIXI_TOML" --as-is -e "$env_name" "$@"
